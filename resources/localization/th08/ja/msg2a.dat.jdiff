{
    "0": {
        "60_0": {
            "lines": [
                "ちょ、ちょっと待って～！"
            ]
        },
        "60_1": {
            "lines": [
                "何？"
            ]
        },
        "60_2": {
            "lines": [
                "久しぶりのヒトネギだと思ったのに。"
            ]
        },
        "61_h1_0": {
            "lines": [
                "ミスティア・ローレライ"
            ]
        },
        "61_0": {
            "lines": [
                "あんた達、一体何者なのよ～？"
            ]
        },
        "63_0": {
            "lines": [
                "ん、人間以外。"
            ]
        },
        "63_1": {
            "lines": [
                "人間以外？"
            ]
        },
        "65_0": {
            "lines": [
                "まぁ、人間以外でもなんでもいいけど。"
            ]
        },
        "65_1": {
            "lines": [
                "珍しいわね。この道に以外が通るなんて。"
            ]
        },
        "66_0": {
            "lines": [
                "ふーん。あなたは夜雀のようね。"
            ]
        },
        "67_0": {
            "lines": [
                "あんまり人間ばっか襲ってると～。"
            ]
        },
        "68_0": {
            "lines": [
                "この辺から人間が居なくなるわよ。"
            ]
        },
        "70_0": {
            "lines": [
                "だからといって、人間の代わりに妖怪を",
                "襲ったりはしないんじゃん？"
            ]
        },
        "70_1": {
            "lines": [
                "ほっといてよ。大体、とっくに夜の道から",
                "人間の姿は消えているし。"
            ]
        },
        "71_0": {
            "lines": [
                "居たとしても、よっぽど急ぎか、訳ありか",
                "人間以外だけだわ。"
            ]
        },
        "72_0": {
            "lines": [
                "いい？もう一度言うわ。",
                "私達は、急ぎで訳ありで人間以外なの。"
            ]
        },
        "73_0": {
            "lines": [
                "こんな所で時間を潰している暇は無いわ。",
                "ここを通してくれる？"
            ]
        },
        "74_0": {
            "lines": [
                "この道の先って、あんまり紫の様な妖怪が",
                "行く場所じゃないんだけど……。"
            ]
        },
        "75_0": {
            "lines": [
                "久しぶりの遊び相手なのに……。"
            ]
        },
        "76_0": {
            "lines": [
                "そうだ、里に行って一緒に人間を",
                "からかわない？"
            ]
        },
        "77_0": {
            "lines": [
                "ああもう、私は前から言ってるでしょ！"
            ]
        },
        "78_0": {
            "lines": [
                "？"
            ]
        },
        "79_0": {
            "lines": [
                "？？"
            ]
        },
        "80_0": {
            "lines": [
                "私は鳥目じゃ無いって。"
            ]
        },
        "81_0": {
            "lines": [
                "あ、人間発見。"
            ]
        },
        "82_0": {
            "lines": [
                "私が鳥目にしてあげる！"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "全く、夜雀風情が。"
            ]
        },
        "61_0": {
            "lines": [
                "羽蟲の王気取りは、絶望的に早いわ。"
            ]
        },
        "62_0": {
            "lines": [
                "……今の奴、本当に雀だったの？",
                "暗くてよく見えなかったけど。"
            ]
        },
        "63_0": {
            "lines": [
                "夜の小鳥は大体夜雀よ。"
            ]
        },
        "64_0": {
            "lines": [
                "取り扱いに気を付けないと、暗い所では",
                "目が見えなくなってしまうわ。"
            ]
        },
        "65_0": {
            "lines": [
                "（……雀ってあんなだったかなぁ。",
                "　良く見えなかったけど）"
            ]
        },
        "66_0": {
            "lines": [
                "ああ、人間の里が見えてきたわ。あんたと",
                "一緒に来たくなかったんだけどなぁ……。"
            ]
        }
    }
}