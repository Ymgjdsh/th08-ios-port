{
    "2": {
        "60_0": {
            "lines": [
                "待っていたぞ。"
            ]
        },
        "140_0": {
            "lines": [
                "満月の夜にやってくるとはいい度胸だ。"
            ]
        },
        "230_0": {
            "lines": [
                "肝試しだからな"
            ]
        },
        "320_0": {
            "lines": [
                "あの人間には指一本触れさせない！"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "むしろ何も起きない事が不気味だ。",
                "不条理だな。"
            ]
        },
        "61_0": {
            "lines": [
                "本当の恐怖は、約束された恐怖の",
                "向こうにある。"
            ]
        },
        "62_0": {
            "lines": [
                "居るはずのお化け役が消えたお化け屋敷程、",
                "怖い物は無いのよ。"
            ]
        },
        "123_0": {
            "lines": [
                "鳴く夜雀も黙る丑三つ時の竹林。",
                "こんな時間にほっつき歩く人間が居るなんて。"
            ]
        },
        "124_0": {
            "lines": [
                "何者だ？"
            ]
        },
        "125_0": {
            "lines": [
                "魔理沙、こいつは……。"
            ]
        },
        "126_0": {
            "lines": [
                "私は昔からここに住む人間。",
                "別に取って喰ったりしないよ。"
            ]
        },
        "127_0": {
            "lines": [
                "人間だと？",
                "そうは見えないがな。"
            ]
        },
        "128_0": {
            "lines": [
                "魔理沙、この人は確かに人間みたいだけど。",
                "気をつけて。"
            ]
        },
        "129_0": {
            "lines": [
                "で、こんな時間にここに来た目的は何？"
            ]
        },
        "130_0": {
            "lines": [
                "筍狩り。"
            ]
        },
        "131_0": {
            "lines": [
                "肝試し。"
            ]
        },
        "132_0": {
            "lines": [
                "どっち？"
            ]
        },
        "133_0": {
            "lines": [
                "判れよ……。"
            ]
        },
        "134_0": {
            "lines": [
                "満月の下、人間と妖怪の二人で肝試し。"
            ]
        },
        "135_0": {
            "lines": [
                "人間は勇気があるというか、馬鹿というか。"
            ]
        },
        "136_0": {
            "lines": [
                "そこな人間の肝は、さぞ硬くて歯ごたえが",
                "あるんでしょうね。"
            ]
        },
        "137_0": {
            "lines": [
                "あんた本当に人間か？"
            ]
        },
        "138_0": {
            "lines": [
                "これほど肝好きの人間見たこと無いぜ。",
                "しかも生きているし。"
            ]
        },
        "139_0": {
            "lines": [
                "魔理沙には生きている様に見える？"
            ]
        },
        "140_0": {
            "lines": [
                "私には死んでいる様に見える。",
                "いや、生きていない様に見える、かな？"
            ]
        },
        "141_0": {
            "lines": [
                "もう、人を幽霊みたいに扱ってぇ。"
            ]
        },
        "142_0": {
            "lines": [
                "でも、殆ど正解だわ。",
                "なかなかの幻視力ね。"
            ]
        },
        "143_0": {
            "lines": [
                "肝好きってところか？"
            ]
        },
        "144_0": {
            "lines": [
                "実はね。"
            ]
        },
        "145_0": {
            "lines": [
                "私には死が無いの。"
            ]
        },
        "146_0": {
            "lines": [
                "死なないって事は、生きてもいない。"
            ]
        },
        "147_0": {
            "lines": [
                "死と生という余計な状態が無くなり、",
                "純粋な人間に近い人間。"
            ]
        },
        "148_0": {
            "lines": [
                "ある意味幽霊みたいなものかもね。"
            ]
        },
        "149_0": {
            "lines": [
                "死なないですって！",
                "煮ても焼いても。"
            ]
        },
        "150_0": {
            "lines": [
                "蒸しても揚げてもなんて言ったか？"
            ]
        },
        "151_0": {
            "lines": [
                "人間が不老不死になったって事は……。"
            ]
        },
        "152_0": {
            "lines": [
                "例の伝説の薬が存在するって事よ。",
                "やっぱり嘘じゃなかったんだ。"
            ]
        },
        "153_0": {
            "lines": [
                "何の話か判らんな。"
            ]
        },
        "154_0": {
            "lines": [
                "一体、誰に嘘の様な本当の話を",
                "吹き込まれたと言うんだ？"
            ]
        },
        "155_0": {
            "lines": [
                "例の薬？",
                "蓬莱の事？"
            ]
        },
        "156_0": {
            "lines": [
                "そんなもの、とうの昔に全て使って",
                "しまったよ。"
            ]
        },
        "157_0": {
            "lines": [
                "確かに私はその薬を奪って、不老不死となり",
                "今に至る。"
            ]
        },
        "158_0": {
            "lines": [
                "輝夜はいまだ私を亡き者にしようとするが、",
                "それも無理な話ね。"
            ]
        },
        "159_0": {
            "lines": [
                "もう千年以上も続く馬鹿な争いよ。"
            ]
        },
        "160_0": {
            "lines": [
                "判ったぜ。",
                "全て判った。"
            ]
        },
        "161_0": {
            "lines": [
                "やっぱり、今回の肝試しのお化け役はお前だ。"
            ]
        },
        "162_0": {
            "lines": [
                "輝夜に肝試しの話を持ちかけられた時から",
                "おかしいと思ったんだ。"
            ]
        },
        "163_0": {
            "lines": [
                "輝夜を倒した私なら、お前を始末できると",
                "踏んだんだろうな。"
            ]
        },
        "164_0": {
            "lines": [
                "ちょっと！　輝夜を倒したのは魔理沙一人の",
                "力じゃないでしょ？"
            ]
        },
        "165_0": {
            "lines": [
                "それに、人間を倒すのは妖怪の仕事。",
                "目の前の貴方は、私に倒されるべきなの。"
            ]
        },
        "166_0": {
            "lines": [
                "なんと、輝夜を倒した？",
                "目の前のこんな二人が？"
            ]
        },
        "167_0": {
            "lines": [
                "なんと言うことかしら。あのにっくき月人が",
                "こんな人妖にやられるなんて。"
            ]
        },
        "168_0": {
            "lines": [
                "これは久しぶりに歯応えのある刺客に",
                "なりそうね。"
            ]
        },
        "169_0": {
            "lines": [
                "いや、歯応えがあるのは肝かしら？"
            ]
        },
        "170_0": {
            "lines": [
                "残念だわ、蓬莱の薬。",
                "是非とも手に入れてみたかったわね。"
            ]
        },
        "171_0": {
            "lines": [
                "私の肝は健康だ。硬くは無い。",
                "したがって私には薬は不要だよ。"
            ]
        },
        "172_0": {
            "lines": [
                "蓬莱の薬、人間は決して口にしては",
                "ならぬ禁忌の薬。"
            ]
        },
        "173_0": {
            "lines": [
                "一度手をだしゃ、大人になれぬ。",
                "ニ度手をだしゃ、病苦も忘れる。"
            ]
        },
        "174_0": {
            "lines": [
                "三度手をだしゃ……、",
                "お前達も永遠の苦輪に悩むがいい！"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "あーれー。",
                "歯応え在りすぎるぅ。"
            ]
        },
        "61_0": {
            "lines": [
                "まだやるか？",
                "死なない、ってのは本当の様だな。"
            ]
        },
        "62_0": {
            "lines": [
                "死ななくても、そろそろ動ける限界が来てる",
                "んじゃないかしら？"
            ]
        },
        "63_0": {
            "lines": [
                "もうとっくに限界よ。いい加減にしないと、",
                "明日筋肉痛で動けなくなっちゃうわ。"
            ]
        },
        "64_0": {
            "lines": [
                "筋肉痛で済むの？"
            ]
        },
        "65_0": {
            "lines": [
                "いつも思うんだが、不老不死の体を丁度",
                "半分に割ると、どっちが本体になるんだ？"
            ]
        },
        "66_0": {
            "lines": [
                "いつも思わないでよそんなこと。"
            ]
        },
        "67_0": {
            "lines": [
                "不老不死は、肉体を捨てる事。"
            ]
        },
        "68_0": {
            "lines": [
                "魂のみが本体となり、新しい肉体を生める",
                "ようになる事よ。"
            ]
        },
        "69_0": {
            "lines": [
                "魂は大きさを持たないから、好きな所に",
                "新しい肉体を造る。"
            ]
        },
        "70_0": {
            "lines": [
                "逆に魂を失った肉体はすぐに滅ぶでしょう？"
            ]
        },
        "71_0": {
            "lines": [
                "やけに詳しいわね。"
            ]
        },
        "72_0": {
            "lines": [
                "蓬莱の薬を欲しがっていたみたいだし、",
                "不老不死にでもなろうとでも思ったの？"
            ]
        },
        "73_0": {
            "lines": [
                "別に。魂に興味があっただけよ。",
                "人形を自立させられないかと思ってね。"
            ]
        },
        "74_0": {
            "lines": [
                "それに妖怪には効かないんでしょう？",
                "その薬。"
            ]
        },
        "75_0": {
            "lines": [
                "なぁ、気になるんだが。"
            ]
        },
        "76_0": {
            "lines": [
                "魂が大きさを持たないなら、妖夢にくっつい",
                "ているアレはなんなんだ？"
            ]
        },
        "77_0": {
            "lines": [
                "アレは幽霊でしょ？　別物よ。",
                "そんなところを気にしないの。"
            ]
        },
        "78_0": {
            "lines": [
                "私が不死なら幽霊は不生。"
            ]
        },
        "79_0": {
            "lines": [
                "肝と形が異なるだけで、似たようなものかもね。"
            ]
        },
        "80_0": {
            "lines": [
                "そうだった。",
                "どうだ？　私の肝試しは。"
            ]
        },
        "81_0": {
            "lines": [
                "そうねぇ。硬くて黒くて……。",
                "肝硬変？"
            ]
        },
        "82_0": {
            "lines": [
                "げげ、そんなにお酒飲んでたっけ？"
            ]
        },
        "83_0": {
            "lines": [
                "魔理沙、肝臓が悪い時は肝臓を食べるのよ。",
                "それに不老不死の肝はね……。"
            ]
        },
        "84_0": {
            "lines": [
                "不老不死とはいえ、人間の肝はちょっと。"
            ]
        },
        "85_0": {
            "lines": [
                "不老不死の体は、病には冒されないから、",
                "中まで奇麗よ。"
            ]
        },
        "86_0": {
            "lines": [
                "食べさせないけど。"
            ]
        },
        "87_0": {
            "lines": [
                "食べないよぅ……。",
                "不老不死は魅力だがな。"
            ]
        }
    }
}