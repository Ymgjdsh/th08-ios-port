{
    "2": {
        "60_0": {
            "lines": [
                "ああもう。"
            ]
        },
        "61_0": {
            "lines": [
                "こっちに来させちゃ駄目だって言ってるのに。"
            ]
        },
        "62_0": {
            "lines": [
                "妖夢。",
                "行くわよ。"
            ]
        },
        "63_0": {
            "lines": [
                "ええ、行きますとも。"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "幽々子さま。",
                "見てください、凄い満月ですよ。"
            ]
        },
        "121_0": {
            "lines": [
                "これが本当の満月。"
            ]
        },
        "122_0": {
            "lines": [
                "貴方達は人間でも妖怪でもないみたいね。"
            ]
        },
        "123_0": {
            "lines": [
                "何でこんな所に迷い込んできたのかしら。"
            ]
        },
        "124_0": {
            "lines": [
                "妖夢。"
            ]
        },
        "125_0": {
            "lines": [
                "あの月の顔を見るのは忌まわしい事よ。"
            ]
        },
        "126_0": {
            "lines": [
                "今すぐに見るのをやめなさい。"
            ]
        },
        "127_0": {
            "lines": [
                "え、えぇ、そうなのですか？"
            ]
        },
        "128_0": {
            "lines": [
                "本当の月は忌まわしいもの。"
            ]
        },
        "129_0": {
            "lines": [
                "地上人はその事を忘れて久しい。"
            ]
        },
        "130_0": {
            "lines": [
                "貴方は懐かしい人ね。"
            ]
        },
        "131_0": {
            "lines": [
                "いや、人だった者かな？"
            ]
        },
        "132_0": {
            "lines": [
                "まだまだ人のつもりだけど。"
            ]
        },
        "133_0": {
            "lines": [
                "でもね、この娘はまだ半分人なの。"
            ]
        },
        "134_0": {
            "lines": [
                "半分だけでもおかしくなったら困るわ。"
            ]
        },
        "135_0": {
            "lines": [
                "幽々子さま。",
                "月を見ないであいつを見るのは無理です！"
            ]
        },
        "136_0": {
            "lines": [
                "心の目で見るのよ。"
            ]
        },
        "137_0": {
            "lines": [
                "その大きな半幽霊は何の為に付いているの？"
            ]
        },
        "138_0": {
            "lines": [
                "心眼の為ではないですよ。"
            ]
        },
        "139_0": {
            "lines": [
                "楽しいわね。"
            ]
        },
        "140_0": {
            "lines": [
                "穢い人間でも妖怪でもない者か。"
            ]
        },
        "141_0": {
            "lines": [
                "見ていて気持ちのいい位、何にもないのね。"
            ]
        },
        "142_0": {
            "lines": [
                "幽々子さま、大変です。",
                "目を瞑ったら真っ暗です！"
            ]
        },
        "143_0": {
            "lines": [
                "少しくらいこの満月みて狂った方が",
                "いいんじゃない？"
            ]
        },
        "144_0": {
            "lines": [
                "見えなくても刀は物を斬れるでしょう？"
            ]
        },
        "145_0": {
            "lines": [
                "で、今日はどうしたの？",
                "幽霊が何の用なの？"
            ]
        },
        "146_0": {
            "lines": [
                "珠はね、少しでも欠けると価値は無くなるの。"
            ]
        },
        "147_0": {
            "lines": [
                "それは、永遠に丸のままではいられないからよ。"
            ]
        },
        "148_0": {
            "lines": [
                "でもね、その傷が付いた珠も、転がしている",
                "うちにまた珠に戻る。"
            ]
        },
        "149_0": {
            "lines": [
                "そういうことでしょう？"
            ]
        },
        "150_0": {
            "lines": [
                "あー、急に目を開けると眩しさに眼が眩む。"
            ]
        },
        "151_0": {
            "lines": [
                "そう、永遠とはそういうこと。",
                "ワビの世界よ。"
            ]
        },
        "152_0": {
            "lines": [
                "実は私、永遠を操る事が出来るの。"
            ]
        },
        "153_0": {
            "lines": [
                "ってことは、今夜を止めていたのも",
                "貴方かしら？"
            ]
        },
        "154_0": {
            "lines": [
                "え？",
                "幽々子さま、それはその……。"
            ]
        },
        "155_0": {
            "lines": [
                "そんな酷い事をするのは私じゃないわ。"
            ]
        },
        "156_0": {
            "lines": [
                "これは信じていいわよ。"
            ]
        },
        "157_0": {
            "lines": [
                "まぁ、どうでもいいわそんなこと。"
            ]
        },
        "158_0": {
            "lines": [
                "私は、幻想郷に満月が戻ればそれでいいの。"
            ]
        },
        "159_0": {
            "lines": [
                "朝にはそのうちなるでしょうし。"
            ]
        },
        "160_0": {
            "lines": [
                "良く言いますね。"
            ]
        },
        "161_0": {
            "lines": [
                "妖夢、これは最後の命令よ。"
            ]
        },
        "162_0": {
            "lines": [
                "目の前の永遠を斬りなさい。"
            ]
        },
        "163_0": {
            "lines": [
                "あら、永遠は傷が付いても永遠よ。",
                "さっきそう言っていたでしょう？"
            ]
        },
        "164_0": {
            "lines": [
                "だから斬るんですよね！",
                "この白楼剣で！"
            ]
        },
        "165_0": {
            "lines": [
                "さっきはああ言ってたけど、夜を止め",
                "ていたのはこいつの仕業よ、きっと。"
            ]
        },
        "166_0": {
            "lines": [
                "いや、それは違うと……。"
            ]
        },
        "167_0": {
            "lines": [
                "違うって言ってるでしょ？"
            ]
        },
        "168_0": {
            "lines": [
                "まぁいいわ。",
                "そんなに私と戦いたいのならやりましょう？"
            ]
        },
        "169_0": {
            "lines": [
                "今まで、何人もの人間が敗れ去って",
                "いった五つの問題。"
            ]
        },
        "170_0": {
            "lines": [
                "貴方達に幾つ解けるかしら？"
            ]
        }
    },
    "3": {
        "60_0": {
            "lines": [
                "なんて事！"
            ]
        },
        "61_0": {
            "lines": [
                "そう、夜を止めていたのは……、"
            ]
        },
        "62_0": {
            "lines": [
                "貴方達だったのね。"
            ]
        }
    },
    "6": {
        "60_0": {
            "lines": [
                "貴方達が作った半端な永遠の夜なんて……"
            ]
        }
    },
    "7": {
        "60_0": {
            "lines": [
                "私の永遠を操る術で全て破って見せる。"
            ]
        }
    },
    "8": {
        "60_0": {
            "lines": [
                "夜明けはすぐそこにあるはずよ。"
            ]
        }
    },
    "9": {
        "60_0": {
            "lines": [
                "どう？",
                "これで永夜の術は破れて、夜は明ける！"
            ]
        }
    }
}