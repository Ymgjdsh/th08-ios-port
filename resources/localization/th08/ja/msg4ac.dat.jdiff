{
    "0": {
        "60_0": {
            "lines": [
                "そこまでよ！"
            ]
        },
        "121_0": {
            "lines": [
                "やっぱりあんたね。"
            ]
        },
        "121_1": {
            "lines": [
                "どうりで、時間の流れがおかしいと思ったよ。"
            ]
        },
        "122_0": {
            "lines": [
                "ほら、普段からおかしな事してるんでしょ？",
                "咲夜って、そうだもんねぇ。"
            ]
        },
        "123_0": {
            "lines": [
                "まぁ、酷いですわ。"
            ]
        },
        "124_0": {
            "lines": [
                "まぁ、いつもおかしな事はしてるけど。",
                "今日は一段と大きな事をしてるわね。"
            ]
        },
        "125_0": {
            "lines": [
                "まるで、紅い霧のあの時みたいだわ。"
            ]
        },
        "126_0": {
            "lines": [
                "おかしな事をしているのは咲夜だけど、",
                "大きな事をしているのは私達じゃないわ。"
            ]
        },
        "127_0": {
            "lines": [
                "今は、その犯人を懲らしめに動いているの",
                "ですわ。"
            ]
        },
        "128_0": {
            "lines": [
                "鳥の目はごませても。",
                "私の目はごまかせないわ。"
            ]
        },
        "129_0": {
            "lines": [
                "あんたらが動くたびに、時刻が止まる。",
                "夜が延びる。"
            ]
        },
        "130_0": {
            "lines": [
                "夜を止めている犯人は、あんたらだ！"
            ]
        },
        "131_0": {
            "lines": [
                "そりゃ、そうよ。悪いかしら？"
            ]
        },
        "132_0": {
            "lines": [
                "お嬢様。",
                "今は、夜を止める事が目的ではありません。"
            ]
        },
        "133_0": {
            "lines": [
                "霊夢の後ろの月を見て下さい。",
                "ほらもうこんなに……。"
            ]
        },
        "134_0": {
            "lines": [
                "あの月と、終らない夜は関係無いでしょ？"
            ]
        },
        "135_0": {
            "lines": [
                "夜を止めて、そんでもって吸血鬼が跋扈して、"
            ]
        },
        "136_0": {
            "lines": [
                "これほど危険な夜もないわ！"
            ]
        },
        "137_0": {
            "lines": [
                "もう、私は夜の王なんだからその位",
                "許してよぉ。"
            ]
        },
        "138_0": {
            "lines": [
                "おっしゃってる意味があまり……。"
            ]
        },
        "139_0": {
            "lines": [
                "とにかく、この場で時刻の進みを",
                "正常に戻させる。"
            ]
        },
        "140_0": {
            "lines": [
                "妖怪を退治するのが私の仕事よ！"
            ]
        },
        "141_0": {
            "lines": [
                "あなたにはまだ判っていないようね。",
                "私たちが夜を止めている理由が。"
            ]
        },
        "142_0": {
            "lines": [
                "咲夜、ここは急がなくてもいいわ。"
            ]
        },
        "143_0": {
            "lines": [
                "あなたが時刻を調整してくれるのなら。",
                "私は誤解のままでもかまわない。"
            ]
        },
        "144_0": {
            "lines": [
                "何時ぞやの借りを返すチャンスなの。"
            ]
        },
        "145_0": {
            "lines": [
                "お嬢様がそうおっしゃるのなら……。"
            ]
        },
        "146_0": {
            "lines": [
                "さぁ、棺桶に戻る覚悟はいい？"
            ]
        },
        "147_0": {
            "lines": [
                "棺桶は死人の入るものだって、",
                "前に言ったじゃない。"
            ]
        },
        "148_0": {
            "lines": [
                "紅くて冥くて窓の少ない棺桶よ！"
            ]
        },
        "120_0": {
            "lines": [
                "やっぱりあんたね。",
                "どうりで、時間の流れがおかしいと思ったよ。"
            ]
        },
        "121_2": {
            "lines": [
                "何の事かしら？"
            ]
        }
    },
    "2": {
        "60_0": {
            "lines": [
                "逃げたわ！そっち。"
            ]
        },
        "61_0": {
            "lines": [
                "私のナイフから逃げられると思って？"
            ]
        }
    },
    "3": {
        "60_0": {
            "lines": [
                "この竹林で迷わないなんて……。"
            ]
        },
        "61_0": {
            "lines": [
                "あなたの後を追ってきたの。",
                "逃さないわ。"
            ]
        },
        "62_0": {
            "lines": [
                "さっきは、いきなり二人で驚いただけ。",
                "もう準備は出来たわ。"
            ]
        },
        "63_0": {
            "lines": [
                "あんたらを、結界のすきまに落とし込む！"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "借りは返したわ。"
            ]
        },
        "61_0": {
            "lines": [
                "血は飲まないでおいてあげるから、",
                "さっさとお帰り。"
            ]
        },
        "62_0": {
            "lines": [
                "うーん。",
                "夜を止めたりして、一体何が目的なのよ。"
            ]
        },
        "63_0": {
            "lines": [
                "そういう質問は、闘う前にするものよ。"
            ]
        },
        "64_0": {
            "lines": [
                "今は、私たちの勝った後なので、答える必要は",
                "無いわ。"
            ]
        },
        "65_0": {
            "lines": [
                "永遠の満月の復元（ボソ）"
            ]
        },
        "66_0": {
            "lines": [
                "永遠は付かせません！"
            ]
        },
        "67_0": {
            "lines": [
                "明日になっても夜のままだったら嫌だなぁ。"
            ]
        },
        "68_0": {
            "lines": [
                "咲夜、あれ。",
                "あの屋敷……。"
            ]
        }
    }
}