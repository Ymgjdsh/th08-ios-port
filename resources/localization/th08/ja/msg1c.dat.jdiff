{
    "0": {
        "60_0": {
            "lines": [
                "咲夜、別に付いて来いとは言ってないわ。"
            ]
        },
        "61_0": {
            "lines": [
                "何言ってるのですか、私は心配してるのですよ。"
            ]
        },
        "62_0": {
            "lines": [
                "また、さっきみたいな虫が現れたら……"
            ]
        },
        "62_1": {
            "lines": [
                "現れたら、って時は現れるのよ！"
            ]
        },
        "123_0": {
            "lines": [
                "さぁ、現れたわ。",
                "そのお嬢様を渡して貰おうかしら！"
            ]
        },
        "124_0": {
            "lines": [
                "現れたら……、虫が可哀相でしょ？"
            ]
        },
        "125_0": {
            "lines": [
                "五分の虫にも一分の魂でしたっけ？"
            ]
        },
        "126_0": {
            "lines": [
                "八割減ね。"
            ]
        },
        "127_0": {
            "lines": [
                "もしかして、物騒な話？"
            ]
        },
        "128_0": {
            "lines": [
                "いえ、殺生な話。"
            ]
        },
        "129_0": {
            "lines": [
                "良いのよ、私は人間以外には興味が無いから。"
            ]
        },
        "130_0": {
            "lines": [
                "興味が無いから心配なのですよ。"
            ]
        },
        "131_0": {
            "lines": [
                "人間なら食料で済むかも知れないけど、",
                "それ以下だと……。"
            ]
        },
        "132_0": {
            "lines": [
                "はぁ、無慈悲にも程があります。"
            ]
        },
        "133_0": {
            "lines": [
                "ひぇぇ"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "あーあ。",
                "最近、蛍も増えてきて綺麗ですね。"
            ]
        },
        "61_0": {
            "lines": [
                "咲夜、その感嘆符と内容が合っていないわ。"
            ]
        },
        "62_0": {
            "lines": [
                "途中で話題を変えたのですよ。お嬢様。"
            ]
        },
        "63_0": {
            "lines": [
                "後半しか伝わらなかったわ。",
                "何が言いたかったのかしらね。"
            ]
        }
    }
}