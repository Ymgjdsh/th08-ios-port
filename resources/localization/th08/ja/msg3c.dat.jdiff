{
    "2": {
        "61_0": {
            "lines": [
                "お前達か。",
                "こんな真夜中に里を襲おうとする奴は。"
            ]
        },
        "62_0": {
            "lines": [
                "お嬢様。",
                "こんなところ、さっさと通り抜けましょう。"
            ]
        },
        "63_0": {
            "lines": [
                "まぁ、別に餓えてはいないけど……"
            ]
        },
        "64_0": {
            "lines": [
                "まったく、ここの人間が居なくなったら",
                "残るは妖怪と変な人間だけになるじゃないか！"
            ]
        }
    },
    "3": {
        "61_0": {
            "lines": [
                "むむ、お前達何もんだ？"
            ]
        },
        "62_0": {
            "lines": [
                "ふん。もう後が無いんじゃないかい？"
            ]
        },
        "63_0": {
            "lines": [
                "お嬢様！",
                "少々お戯れが過ぎますよ。"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "よく見てみな。悪魔達よ。"
            ]
        },
        "60_1": {
            "lines": [
                "達って、ねぇ。"
            ]
        },
        "61_0": {
            "lines": [
                "ここには何も無かった。",
                "そう見えるだろう？"
            ]
        },
        "62_0": {
            "lines": [
                "って、ここは人間の里でしょ？"
            ]
        },
        "63_0": {
            "lines": [
                "ああ、私はあんまり来る事は無いけど、",
                "咲夜はよく来ているのかしら？"
            ]
        },
        "64_0": {
            "lines": [
                "ええ、うちのお屋敷の道具は人間製のもの",
                "も結構有りますわ。"
            ]
        },
        "65_0": {
            "lines": [
                "よく見て……。",
                "見ての通り、ここには何も無かったんだよ。"
            ]
        },
        "66_0": {
            "lines": [
                "いいから、さっさと通り過ぎな。"
            ]
        },
        "67_0": {
            "lines": [
                "なんか嫌な態度ね。"
            ]
        },
        "68_0": {
            "lines": [
                "里と人間をどこやったのかしら？"
            ]
        },
        "69_0": {
            "lines": [
                "判らんのか？",
                "そもそも、人間は居なかった事にした。"
            ]
        },
        "70_0": {
            "lines": [
                "今、ここの里の歴史は全て私が",
                "保護している。"
            ]
        },
        "71_0": {
            "lines": [
                "咲夜。"
            ]
        },
        "72_0": {
            "lines": [
                "妹の家庭教師に良いんじゃない？",
                "郷土歴史学の先生って感じで。"
            ]
        },
        "73_0": {
            "lines": [
                "うちにはもう知識人は要りませんわ……。"
            ]
        },
        "74_0": {
            "lines": [
                "いいか、もう一度言う。"
            ]
        },
        "75_0": {
            "lines": [
                "ここには元々何も無かった。",
                "人間も人間の里もだ。"
            ]
        },
        "76_0": {
            "lines": [
                "どうも、その言い方がひっかかるのよね。"
            ]
        },
        "77_0": {
            "lines": [
                "お嬢様。",
                "少々時間を頂けますか？"
            ]
        },
        "78_0": {
            "lines": [
                "急いでるんだけどね。物凄く。"
            ]
        },
        "79_0": {
            "lines": [
                "そこの悪魔の歴史も私が頂こうか？"
            ]
        },
        "80_0": {
            "lines": [
                "ふん、偉そうね。",
                "ワーハクタクの癖に。"
            ]
        },
        "81_0": {
            "lines": [
                "歴史ばっかリ見ているお前には、",
                "運命は変えられないよ。"
            ]
        },
        "82_0": {
            "lines": [
                "お嬢様。",
                "時間を頂いてもいいのですね？"
            ]
        },
        "83_0": {
            "lines": [
                "しょうがないわねぇ。",
                "ちょっとなら、私の時間も使っても良いわ。"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "さぁ、すっきりしたところで先を",
                "急ぎましょう。"
            ]
        },
        "61_0": {
            "lines": [
                "まだ、里は元に戻ってないけど",
                "もうすっきりしたの？"
            ]
        },
        "62_0": {
            "lines": [
                "もうすっきりしたわ。きれいさっぱり。"
            ]
        },
        "63_0": {
            "lines": [
                "まぁいいけど、こいつのお陰ですっかり妖気の",
                "上流の方向を見失ったわ。"
            ]
        },
        "64_0": {
            "lines": [
                "咲夜は、行き先が分かってるのかしら。"
            ]
        },
        "65_0": {
            "lines": [
                "きれいさっぱりですわ。",
                "でもほら、こんなときに便利な奴がいます。"
            ]
        },
        "66_0": {
            "lines": [
                "あー？満月の異変の原因？"
            ]
        },
        "67_0": {
            "lines": [
                "それは、あいつの仕業だろう。",
                "こんな事出来る奴なんてそうそう居ないしな。"
            ]
        },
        "68_0": {
            "lines": [
                "知識人は役に立つわね。",
                "家にはもう要らないけど。"
            ]
        },
        "69_0": {
            "lines": [
                "家の知識人は本ばっかり読んでて、",
                "あんまり役に立っていない気が……"
            ]
        },
        "70_0": {
            "lines": [
                "ムダ知識が豊富なのですよ。",
                "もう要らないけど。"
            ]
        }
    }
}