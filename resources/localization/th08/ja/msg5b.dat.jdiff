{
    "0": {
        "60_0": {
            "lines": [
                "遅かったわね。"
            ]
        },
        "121_0": {
            "lines": [
                "全ての扉は封印したわ。",
                "もう、姫は連れ出せないでしょう？"
            ]
        },
        "121_1": {
            "lines": [
                "おう。",
                "長くて暗い廊下だったな、アリスよ。"
            ]
        },
        "122_0": {
            "lines": [
                "取り敢えず、相手にしてやったら？",
                "目の前の奴。"
            ]
        },
        "123_0": {
            "lines": [
                "って、何？",
                "あんた達……、地上の人じゃないの。"
            ]
        },
        "124_0": {
            "lines": [
                "こんな夜中に何の用？"
            ]
        },
        "125_0": {
            "lines": [
                "こんだけ長ければ、いくら掃除の達人でも",
                "一日が雑巾掛けだけで終るな。"
            ]
        },
        "126_0": {
            "lines": [
                "魔理沙の家の掃除よりは、時間も手間も",
                "少なくて済むと思うけど。"
            ]
        },
        "127_0": {
            "lines": [
                "って、いい加減相手にしてやったら？"
            ]
        },
        "128_0": {
            "lines": [
                "もう、変なのが紛れ込んできたわね。"
            ]
        },
        "129_0": {
            "lines": [
                "うちは今忙しいの。",
                "こそ泥以外の用が無いならさっさと帰る。"
            ]
        },
        "130_0": {
            "lines": [
                "真夜中に忙しい奴なんてのは、まっとうな",
                "生き方してない奴だけだ。"
            ]
        },
        "131_0": {
            "lines": [
                "なぁ同業者よ。"
            ]
        },
        "132_0": {
            "lines": [
                "魔理沙が本題を言わないなら、私が言うわ。"
            ]
        },
        "133_0": {
            "lines": [
                "歪な月の異変は、あなたかその仲間の",
                "仕業でしょう？"
            ]
        },
        "134_0": {
            "lines": [
                "そうよ。"
            ]
        },
        "135_0": {
            "lines": [
                "さぁ、大人しく元に戻すか、",
                "一悶着あった後に元に戻すか、"
            ]
        },
        "136_0": {
            "lines": [
                "どっちかを選びな！"
            ]
        },
        "137_0": {
            "lines": [
                "美味しい所だけ持っていかないの。"
            ]
        },
        "197_0": {
            "lines": [
                "あの月は、まだ戻す訳にはいかないわ。"
            ]
        },
        "198_0": {
            "lines": [
                "こうしている間にも、月の民との関係は",
                "悪くなりつつあるの。"
            ]
        },
        "199_0": {
            "lines": [
                "もうこのまま、地上を大きな密室にする",
                "しか姫を逃す道は無い。"
            ]
        },
        "200_0": {
            "lines": [
                "ああ？何もんだ？"
            ]
        },
        "201_0": {
            "lines": [
                "魔理沙、危ないわ。",
                "こいつの力は今まで感じた事が無い……。"
            ]
        },
        "202_0": {
            "lines": [
                "あなた達は古代の力のコピーを使用して",
                "いるみたいね。"
            ]
        },
        "203_0": {
            "lines": [
                "まだ人間が居なかった時代の無秩序な力。",
                "あの頃が懐かしいわ。"
            ]
        },
        "204_0": {
            "lines": [
                "能力にも特許を認めるべきかしら。"
            ]
        },
        "205_0": {
            "lines": [
                "まぁ取り敢えず、",
                "ウドンゲ、ここはお前に任せたわ。"
            ]
        },
        "206_0": {
            "lines": [
                "間違っても姫を連れ出されないようにね。"
            ]
        },
        "267_0": {
            "lines": [
                "お任せください。",
                "閉ざされた扉は一つも空かせません。"
            ]
        },
        "268_0": {
            "lines": [
                "なんだぁ？　ベラベラ喋るだけ喋って",
                "逃げるなんてなぁ、"
            ]
        },
        "269_0": {
            "lines": [
                "後で倒しに来てくれ、",
                "って言ってる様なもんだぜ。"
            ]
        },
        "270_0": {
            "lines": [
                "そう言ってたのよ。",
                "でも、後で倒しに行くかどうかは、"
            ]
        },
        "271_0": {
            "lines": [
                "異変の犯人かどうかで決まるの。",
                "それを忘れちゃ朝になってしまうわ。"
            ]
        },
        "272_0": {
            "lines": [
                "あんたら、私を無視しすぎ。"
            ]
        },
        "273_0": {
            "lines": [
                "いい？",
                "この廊下、催眠廊下は私の罠の一つ。"
            ]
        },
        "274_0": {
            "lines": [
                "真っ直ぐに飛べないお前達は、",
                "私の力で跡形も無く消え去るのよ。"
            ]
        },
        "275_0": {
            "lines": [
                "それは魔理沙の台詞。"
            ]
        },
        "276_0": {
            "lines": [
                "光の魔砲で跡形も無く消え去るがいいわ、",
                "このぺんぺん草。"
            ]
        },
        "277_0": {
            "lines": [
                "美味しい所持っていくなよ。"
            ]
        },
        "278_0": {
            "lines": [
                "その台詞、月の兎である私の目を見ても、",
                "まだ吐けるのかしら？"
            ]
        }
    },
    "3": {
        "180_0": {
            "lines": [
                "さっきのを撃ちに行く（FinalA）",
                "あたりかまわず撃ちに行く（FinalB）"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "月は元に戻ったのか？"
            ]
        },
        "61_0": {
            "lines": [
                "いや、こいつじゃないわね。",
                "やっぱりさっきの……。"
            ]
        },
        "62_0": {
            "lines": [
                "私に勝ったからって、師匠に敵うと",
                "思ってるの？"
            ]
        },
        "63_0": {
            "lines": [
                "負けるはずが無いわ。"
            ]
        },
        "64_0": {
            "lines": [
                "なんだか、貧弱そうだったしな。"
            ]
        },
        "65_0": {
            "lines": [
                "今回は、力では私の負けを認めるけど……。"
            ]
        },
        "66_0": {
            "lines": [
                "師匠は、月面一の頭脳の持ち主。"
            ]
        },
        "67_0": {
            "lines": [
                "あんたらみたいな馬鹿共なんか勝負に",
                "なるはずがないわ。"
            ]
        },
        "68_0": {
            "lines": [
                "あー？弾幕に頭脳？",
                "馬鹿じゃないのか？弾幕はパワーだよ。"
            ]
        },
        "69_0": {
            "lines": [
                "そういうこと言うから馬鹿扱いされるのよ。",
                "弾幕はブレイン。常識よ。"
            ]
        }
    },
    "2": {
        "60_0": {
            "lines": [
                "月は元に戻ったのか？"
            ]
        },
        "61_0": {
            "lines": [
                "いや、こいつじゃないわね。",
                "ほら、あそこ……。"
            ]
        },
        "62_0": {
            "lines": [
                "判ってるぜ。あの扉だけ少し開いている。",
                "あんなに強い妖気は初めてだ。"
            ]
        },
        "63_0": {
            "lines": [
                "ああ、そこは。"
            ]
        },
        "64_0": {
            "lines": [
                "火薬庫かしら？"
            ]
        },
        "65_0": {
            "lines": [
                "火薬庫だな。"
            ]
        },
        "66_0": {
            "lines": [
                "それは行くしかないわね。",
                "異変の元凶の火薬庫なら。"
            ]
        },
        "67_0": {
            "lines": [
                "そうだな。",
                "そこに行けば全てが解決する火薬庫だし。"
            ]
        },
        "68_0": {
            "lines": [
                "ああ、師匠に怒られるぅ。"
            ]
        }
    }
}