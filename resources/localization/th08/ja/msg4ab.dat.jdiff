{
    "0": {
        "60_0": {
            "lines": [
                "ちょっと待て！"
            ]
        },
        "121_0": {
            "lines": [
                "何だ、何時までも夜が明けないから",
                "おかしいと思ったら、"
            ]
        },
        "121_1": {
            "lines": [
                "魔理沙の仕業ね。"
            ]
        },
        "121_2": {
            "lines": [
                "おい、誤解だ。",
                "悪いのはこいつ一人だぜ。"
            ]
        },
        "122_0": {
            "lines": [
                "何よ。",
                "あんたも同罪でしょ？"
            ]
        },
        "123_0": {
            "lines": [
                "こんな事して……、",
                "一体何を企んでるのよ。"
            ]
        },
        "124_0": {
            "lines": [
                "あれだな、ほら。",
                "霊夢、なんと言うか……。"
            ]
        },
        "125_0": {
            "lines": [
                "歯切れが悪いわね。",
                "いつもみたいに言えばいいじゃない。"
            ]
        },
        "126_0": {
            "lines": [
                "邪魔だ、そこをどけ！",
                "ってね。"
            ]
        },
        "127_0": {
            "lines": [
                "馬鹿！",
                "こいつを怒らせると不味いぜ。"
            ]
        },
        "128_0": {
            "lines": [
                "私を怒らせる事自体が不味い事でしょ？"
            ]
        },
        "129_0": {
            "lines": [
                "今日はちょっと懲らしめてやらないと",
                "いけないわね。"
            ]
        },
        "130_0": {
            "lines": [
                "ふん。",
                "あんた、後ろ見てもなんとも思わないの？"
            ]
        },
        "131_0": {
            "lines": [
                "もう、歪な月もこんなに判り易く",
                "なってるじゃない！"
            ]
        },
        "132_0": {
            "lines": [
                "ああ！"
            ]
        },
        "133_0": {
            "lines": [
                "この月も、あんたらの仕業ね。"
            ]
        },
        "134_0": {
            "lines": [
                "ああ、もういいぜ。諦めたよ。"
            ]
        },
        "135_0": {
            "lines": [
                "そうだ。",
                "この終らない夜も、欠けて歪な月も、"
            ]
        },
        "136_0": {
            "lines": [
                "消えた人間の里も、",
                "お地蔵さんに傘かぶせて廻ったのも、"
            ]
        },
        "137_0": {
            "lines": [
                "全てはアリスがやった。"
            ]
        },
        "138_0": {
            "lines": [
                "さぁ、そこをどきな！"
            ]
        },
        "139_0": {
            "lines": [
                "まぁいいけどね。"
            ]
        },
        "140_0": {
            "lines": [
                "月の光を蓄えたこの竹林で、"
            ]
        },
        "141_0": {
            "lines": [
                "あんたらは、光る竹の一つになる。",
                "美しいわね。"
            ]
        },
        "142_0": {
            "lines": [
                "その言葉、ちょっと屈折させて",
                "お返ししますわ。"
            ]
        },
        "143_0": {
            "lines": [
                "さぁ！",
                "終らない夜は、ここでお終いよ！"
            ]
        }
    },
    "2": {
        "60_0": {
            "lines": [
                "あれ？",
                "逃げるなんてあいつらしくないな。"
            ]
        },
        "61_0": {
            "lines": [
                "追うわよ。魔理沙。"
            ]
        }
    },
    "3": {
        "60_0": {
            "lines": [
                "さぁ、あんたらに、本当の結界を",
                "見せてあげるわ。"
            ]
        },
        "61_0": {
            "lines": [
                "何で仕切りなおす必要があったんだよ。"
            ]
        },
        "62_0": {
            "lines": [
                "そっちが二人だから二回！"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "さぁ急ぐぜ。"
            ]
        },
        "61_0": {
            "lines": [
                "目的地が見えてきたわ。"
            ]
        },
        "62_0": {
            "lines": [
                "仕様が無いわね。",
                "悪巧みも程ほどにするのよ。"
            ]
        },
        "63_0": {
            "lines": [
                "なんか言った？"
            ]
        },
        "64_0": {
            "lines": [
                "へぇ。竹林の中にこんな大きな屋敷がある",
                "なんて、初めて知ったぜ。"
            ]
        },
        "65_0": {
            "lines": [
                "あー？",
                "私も初めて見たわ。"
            ]
        },
        "66_0": {
            "lines": [
                "じゃぁね。",
                "良い子と負け犬はここでお帰りね。"
            ]
        },
        "67_0": {
            "lines": [
                "霊夢、永遠の一回休みだ。",
                "じゃぁな。"
            ]
        }
    }
}