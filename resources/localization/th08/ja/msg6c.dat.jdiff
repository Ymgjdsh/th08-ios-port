{
    "2": {
        "60_0": {
            "lines": [
                "ふふふ。"
            ]
        },
        "61_0": {
            "lines": [
                "無事ついて来てるようね。"
            ]
        },
        "62_0": {
            "lines": [
                "ほらほら。",
                "もう後が無いんじゃないのか？"
            ]
        },
        "63_0": {
            "lines": [
                "でも、さっきから大分進んでいるけど……。",
                "この廊下、終わりが見えません！"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "廊下は終ったみたいだけど、",
                "ここは一体……。"
            ]
        },
        "121_0": {
            "lines": [
                "この位でいいわね。"
            ]
        },
        "122_0": {
            "lines": [
                "ここまで来ても気が付かないのかしら？"
            ]
        },
        "123_0": {
            "lines": [
                "しまった！",
                "嵌められたわ、咲夜。"
            ]
        },
        "124_0": {
            "lines": [
                "アレは月じゃない！"
            ]
        },
        "125_0": {
            "lines": [
                "確かに、ちょっと大き過ぎますわねぇ。"
            ]
        },
        "126_0": {
            "lines": [
                "いや、大きいのは近い所為だと思うけど。"
            ]
        },
        "127_0": {
            "lines": [
                "そう、貴方達は偽物の月と永い廊下に",
                "導かれてここまで来た。"
            ]
        },
        "128_0": {
            "lines": [
                "満月は、月と地上を結ぶ唯一の鍵なの。"
            ]
        },
        "129_0": {
            "lines": [
                "その鍵を壊せば、月と地上は行き来",
                "出来なくなる。"
            ]
        },
        "130_0": {
            "lines": [
                "ほら、こんな風に偽の幻影に惑わされてね。"
            ]
        },
        "131_0": {
            "lines": [
                "あら、幻影ですって。",
                "さっきの無茶苦茶長い廊下も幻影かしら。"
            ]
        },
        "132_0": {
            "lines": [
                "幻影かもね。"
            ]
        },
        "133_0": {
            "lines": [
                "あんなに長いんじゃ、掃除用のモップが",
                "持たなさそうだし。"
            ]
        },
        "134_0": {
            "lines": [
                "あら、恐らくモップじゃなくて雑巾掛け",
                "じゃないかしら。腰痛めそうね。"
            ]
        },
        "135_0": {
            "lines": [
                "そんなとこ、気にしなくてもいいじゃない。",
                "幻影よ幻影。"
            ]
        },
        "136_0": {
            "lines": [
                "それにしても、こんな大掛かりな事をして",
                "どうしようっての？"
            ]
        },
        "137_0": {
            "lines": [
                "誰も月に行こうとなんてしてないよ。"
            ]
        },
        "138_0": {
            "lines": [
                "幻想郷の外には地上から月に向う愚か者も",
                "居るけど……。"
            ]
        },
        "139_0": {
            "lines": [
                "それより今は、月からの追手から姫を守る",
                "事だけを考えている。"
            ]
        },
        "140_0": {
            "lines": [
                "今夜はこのまま朝を迎えれば、もう",
                "月から使者がやってこないでしょう。"
            ]
        },
        "141_0": {
            "lines": [
                "ああ、さっきから兎ばっかリ出てきたのは",
                "月の兎だったのね。"
            ]
        },
        "142_0": {
            "lines": [
                "いや、殆どは地上で捕まえた兎。"
            ]
        },
        "143_0": {
            "lines": [
                "生粋の月の兎はさっきの鈴仙だけよ。"
            ]
        },
        "144_0": {
            "lines": [
                "どうでもいいよ。"
            ]
        },
        "145_0": {
            "lines": [
                "満月を奪った奴がわかっただけで良いの。",
                "理由なんてどうでもいい。"
            ]
        },
        "146_0": {
            "lines": [
                "ここに来るまで、犯人を見つけたらどう痛み",
                "つけてやろうか、だけを考えてきたわ。"
            ]
        },
        "147_0": {
            "lines": [
                "咲夜、ここは手加減無しよ。"
            ]
        },
        "148_0": {
            "lines": [
                "今まで出会ってきた敵も手加減してない",
                "ですよ。"
            ]
        },
        "149_0": {
            "lines": [
                "……じゃあ、死ぬ気で。"
            ]
        },
        "150_0": {
            "lines": [
                "死にませんよ。"
            ]
        },
        "151_0": {
            "lines": [
                "随分と余裕ねぇ。"
            ]
        },
        "152_0": {
            "lines": [
                "ここまで誘い出したのも、思う存分遊ぶ為。"
            ]
        },
        "153_0": {
            "lines": [
                "安心していいわ。",
                "朝になれば満月は元に戻してあげるから。"
            ]
        },
        "154_0": {
            "lines": [
                "後は、朝まで遊ぶだけでいいのよ。"
            ]
        },
        "155_0": {
            "lines": [
                "お嬢様、良かったですわね。"
            ]
        },
        "156_0": {
            "lines": [
                "勝っても負けても満月は元に戻るようで。"
            ]
        },
        "157_0": {
            "lines": [
                "何を甘い事言ってるの？"
            ]
        },
        "158_0": {
            "lines": [
                "なめられたお返しをしないと、",
                "幻想郷での威厳が保てないじゃないの。"
            ]
        },
        "159_0": {
            "lines": [
                "もはや満月なんてどうでも良いの。"
            ]
        },
        "160_0": {
            "lines": [
                "ふん、ガキの癖に。"
            ]
        },
        "161_0": {
            "lines": [
                "貴方みたいな幼い子供が永遠の民である",
                "私に敵うはずが無いじゃない。"
            ]
        },
        "162_0": {
            "lines": [
                "貴方の積み重ねてきた紅い歴史。"
            ]
        },
        "163_0": {
            "lines": [
                "私の歴史で割れば、ゼロよ。",
                "永久からみれば貴方は須臾。"
            ]
        },
        "164_0": {
            "lines": [
                "ほら、お嬢様。",
                "年長者は敬わないといけませんよ。"
            ]
        },
        "165_0": {
            "lines": [
                "あんたは一番若い。"
            ]
        },
        "166_0": {
            "lines": [
                "あと、夜を止めていたのは貴方達でしょう？"
            ]
        },
        "167_0": {
            "lines": [
                "そんなことして、姫の逆鱗に触れて",
                "なければいいけど……。"
            ]
        },
        "168_0": {
            "lines": [
                "ほれ私を敬いなさい、咲夜。存分に。"
            ]
        },
        "169_0": {
            "lines": [
                "話を聞いていない。"
            ]
        },
        "170_0": {
            "lines": [
                "最近の若い者はこれだから困るよ。"
            ]
        },
        "171_0": {
            "lines": [
                "貴方達には、話よりこの弾幕の薬の方が",
                "必要みたいね！"
            ]
        }
    },
    "3": {
        "60_0": {
            "lines": [
                "何遊んでるのよ！"
            ]
        },
        "61_0": {
            "lines": [
                "永琳、私の力でもう一度だけチャンスをあげる。"
            ]
        },
        "62_0": {
            "lines": [
                "これで負けたらその時は……。"
            ]
        },
        "63_0": {
            "lines": [
                "そこの悪魔！"
            ]
        },
        "64_0": {
            "lines": [
                "私の力で作られた薬と永琳の本当の力、",
                "一生忘れないものになるよ！"
            ]
        }
    }
}