{
    "2": {
        "61_0": {
            "lines": [
                "お前達か。",
                "こんな真夜中に里を襲おうとする奴は。"
            ]
        },
        "62_0": {
            "lines": [
                "この惨状はあんたの仕業ね？",
                "人間と人間の里を何処にやったの？"
            ]
        },
        "63_0": {
            "lines": [
                "お前達妖怪には、人間を渡しはしない。"
            ]
        },
        "64_0": {
            "lines": [
                "今夜を無かった事にしてやる！"
            ]
        }
    },
    "3": {
        "61_0": {
            "lines": [
                "あー、お前達何もんだ？"
            ]
        },
        "62_0": {
            "lines": [
                "ちょっと、里を元に戻しなさい！"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "しつこいな。"
            ]
        },
        "60_1": {
            "lines": [
                "あんたなんかどうでもいいのよ。"
            ]
        },
        "61_0": {
            "lines": [
                "ここは人間の里だった筈でしょ？"
            ]
        },
        "62_0": {
            "lines": [
                "なのに、何も無いじゃない。",
                "人間達や家とかどうしたのよ！"
            ]
        },
        "63_0": {
            "lines": [
                "どうもしてない。"
            ]
        },
        "64_h1_0": {
            "lines": [
                "上白沢　慧音"
            ]
        },
        "64_0": {
            "lines": [
                "お前達には見えないようにしてやっただけだ。"
            ]
        },
        "65_0": {
            "lines": [
                "霊夢、こんな所でしっぽりしている暇は無いわ。"
            ]
        },
        "66_0": {
            "lines": [
                "こうしている間にも月はどんどん沈んでいるの。"
            ]
        },
        "67_0": {
            "lines": [
                "しっぽりはしてないけど、ちょっと待って。"
            ]
        },
        "68_0": {
            "lines": [
                "人間を里ごと消している妖怪を見逃す訳には",
                "いかない。"
            ]
        },
        "69_0": {
            "lines": [
                "ここには、元々人間は住んでいなかった。"
            ]
        },
        "70_0": {
            "lines": [
                "と言う風に見える様にしただけだ。"
            ]
        },
        "71_0": {
            "lines": [
                "私が、この不吉な夜から人間を守る。"
            ]
        },
        "72_0": {
            "lines": [
                "ねぇねぇ。"
            ]
        },
        "73_0": {
            "lines": [
                "私には普通に人間の姿が見えるんだけどさぁ。"
            ]
        },
        "74_0": {
            "lines": [
                "この程度のまやかしなんて、全然役に立たない",
                "じゃない？"
            ]
        },
        "75_0": {
            "lines": [
                "！"
            ]
        },
        "76_0": {
            "lines": [
                "お前達、本当に何もんだ？"
            ]
        },
        "77_0": {
            "lines": [
                "大丈夫。私には里は見えないわ。"
            ]
        },
        "78_0": {
            "lines": [
                "うう。そんな情けかけられても。"
            ]
        },
        "79_0": {
            "lines": [
                "それにあんた。"
            ]
        },
        "80_0": {
            "lines": [
                "半獣なんでしょ？"
            ]
        },
        "81_0": {
            "lines": [
                "満月じゃなければ人間だ。"
            ]
        },
        "82_0": {
            "lines": [
                "人面犬とか人面岩とかと大差ないわね。"
            ]
        },
        "83_0": {
            "lines": [
                "何で顔だけ残して変身する必要があるんだよ。",
                "変身は全身だ。"
            ]
        },
        "84_0": {
            "lines": [
                "牛頭馬頭とか、頭だけ獣に変身。"
            ]
        },
        "85_0": {
            "lines": [
                "……まぁいい。"
            ]
        },
        "86_0": {
            "lines": [
                "そこまで言うなら、もう後には引かせない。"
            ]
        },
        "87_0": {
            "lines": [
                "今夜は、お前達の歴史で満漢全席だ！"
            ]
        },
        "88_0": {
            "lines": [
                "私はともかく、こいつの歴史は点心位に",
                "しかならないわ。"
            ]
        },
        "89_0": {
            "lines": [
                "うるさいなぁ。",
                "それだけ毎日が飲茶なのよ。"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "さぁ、人間の里を元に戻しなさい！"
            ]
        },
        "61_0": {
            "lines": [
                "戻しても大丈夫よ。",
                "元々ここの人間とあんたなんか眼中に無いわ。"
            ]
        },
        "62_0": {
            "lines": [
                "じゃぁ、何処に行こうとしてるんだ？"
            ]
        },
        "63_0": {
            "lines": [
                "あっち。"
            ]
        },
        "64_0": {
            "lines": [
                "こっち。"
            ]
        },
        "65_0": {
            "lines": [
                "……。"
            ]
        },
        "66_0": {
            "lines": [
                "昨今の異常な月の原因を作った奴なら、",
                "そっち。"
            ]
        },
        "67_0": {
            "lines": [
                "ほら言ったとおりじゃない。"
            ]
        },
        "68_0": {
            "lines": [
                "霊夢の指先と70度は違う向きね。"
            ]
        },
        "69_0": {
            "lines": [
                "あんたは110度違う。",
                "ってあんた、良く私達の目的が判ったわね。"
            ]
        },
        "70_0": {
            "lines": [
                "判らない方がおかしいのよ。"
            ]
        }
    }
}