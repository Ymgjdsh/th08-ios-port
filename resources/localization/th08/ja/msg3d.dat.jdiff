{
    "2": {
        "61_0": {
            "lines": [
                "お前達か。",
                "こんな真夜中に里を襲おうとする奴は。"
            ]
        },
        "62_0": {
            "lines": [
                "あれ？",
                "変な所に迷い込んでしまったわ。"
            ]
        },
        "63_0": {
            "lines": [
                "ここは何処でしょう……？"
            ]
        },
        "64_0": {
            "lines": [
                "迷子の振りしても無駄だ。",
                "不吉な亡霊達よ。"
            ]
        }
    },
    "3": {
        "61_0": {
            "lines": [
                "くそ！",
                "亡霊がなんで。"
            ]
        },
        "62_0": {
            "lines": [
                "酷いわね。",
                "亡霊を人外扱いして。"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "こんな所まで何の用だ？"
            ]
        },
        "60_1": {
            "lines": [
                "さっき、攻撃してきたでしょ？",
                "そのお返し、よ。"
            ]
        },
        "61_0": {
            "lines": [
                "ここには何も無い。",
                "さっさと通り過ぎるが良い。"
            ]
        },
        "62_0": {
            "lines": [
                "といっても、実は目的地が分かって",
                "いないので……。"
            ]
        },
        "63_0": {
            "lines": [
                "当ても無くふらふらしているのか？"
            ]
        },
        "64_0": {
            "lines": [
                "いやいや、妖夢。"
            ]
        },
        "65_0": {
            "lines": [
                "ちゃんと目的地に向っているわ。",
                "あなたは私の言う通りにすればいいのよ。"
            ]
        },
        "66_0": {
            "lines": [
                "お前達の目的とは何だ？"
            ]
        },
        "67_0": {
            "lines": [
                "この異常な月を元に戻す事。"
            ]
        },
        "68_0": {
            "lines": [
                "いやいや、妖夢。"
            ]
        },
        "69_0": {
            "lines": [
                "！？"
            ]
        },
        "70_0": {
            "lines": [
                "素敵でお腹いっぱいな夜の観光旅行。"
            ]
        },
        "71_0": {
            "lines": [
                "なんだか物凄く怪しい奴等だな。"
            ]
        },
        "72_0": {
            "lines": [
                "ただでさえ幽霊は怪しいのに。"
            ]
        },
        "73_0": {
            "lines": [
                "まて、それは聞き捨てならないな。",
                "幽霊は怪しくない。"
            ]
        },
        "74_0": {
            "lines": [
                "いやいや。"
            ]
        },
        "75_0": {
            "lines": [
                "うるさい。"
            ]
        },
        "76_0": {
            "lines": [
                "……やはり、お前達は危険そうだな。",
                "ここから追い出すしか無さそうだ。"
            ]
        },
        "77_0": {
            "lines": [
                "よく分からん奴らだが。"
            ]
        },
        "78_0": {
            "lines": [
                "ねぇねぇ妖夢。"
            ]
        },
        "79_0": {
            "lines": [
                "今日は、虫、鳥、と来て次は獣よ。"
            ]
        },
        "80_0": {
            "lines": [
                "何が言いたいのですか。"
            ]
        },
        "81_0": {
            "lines": [
                "ふん、お前達の歴史は全て頂く！"
            ]
        },
        "82_0": {
            "lines": [
                "お前達が幽霊になる前も、全てだ。"
            ]
        },
        "83_0": {
            "lines": [
                "次は龍かしらね。"
            ]
        },
        "84_0": {
            "lines": [
                "幽々子さま。次の事考える前に",
                "目の前の事を考えてください。"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "獣、って人間を獣扱いしないで下さいよ。"
            ]
        },
        "61_0": {
            "lines": [
                "いやいや、妖夢。"
            ]
        },
        "62_0": {
            "lines": [
                "この娘は今は人間の姿をしているけど、",
                "半分獣よ。あなたみたいね。"
            ]
        },
        "63_0": {
            "lines": [
                "もっとも、人間も獣だと思うので足して",
                "２半獣かな？"
            ]
        },
        "64_0": {
            "lines": [
                "くそ、月が不完全じゃなければ",
                "こんな幽霊なんかに……。"
            ]
        },
        "65_0": {
            "lines": [
                "そうそうそう。",
                "満月を取り戻さないといけないんでした。"
            ]
        },
        "66_0": {
            "lines": [
                "さぁ、次は龍料理ね。",
                "楽しみだわ。妖夢。"
            ]
        },
        "67_0": {
            "lines": [
                "幽々子さま、目的地は分かっているって",
                "言ってましたよね？"
            ]
        },
        "68_0": {
            "lines": [
                "なんか不安になってきましたよ。"
            ]
        },
        "69_0": {
            "lines": [
                "でも、龍は鱗が多そうね。"
            ]
        }
    }
}