{
    "0": {
        "60_0": {
            "lines": [
                "ちょ、ちょっと待って～！"
            ]
        },
        "60_1": {
            "lines": [
                "急いでるのよ。",
                "動きながらなら聞いてあげるわ。"
            ]
        },
        "60_2": {
            "lines": [
                "言っても止まらないくせに。",
                "でも、人間と蝙蝠。不思議な組み合わせね。"
            ]
        },
        "61_0": {
            "lines": [
                "人間は欲しいけど、そいつはいらない。"
            ]
        },
        "63_0": {
            "lines": [
                "ふん。餓鬼が夜遊びか？"
            ]
        },
        "63_1": {
            "lines": [
                "勿論、夜遊びよ。",
                "良い子の昼間はおねむの時間。"
            ]
        },
        "64_0": {
            "lines": [
                "夜は人狩りサービスタイムよ。"
            ]
        },
        "66_0": {
            "lines": [
                "悪いけど急いでるんだ。",
                "さっさとやられてくれないか？"
            ]
        },
        "66_1": {
            "lines": [
                "ちょっと待って、って言ってるでしょ？"
            ]
        },
        "67_0": {
            "lines": [
                "お嬢様。"
            ]
        },
        "68_0": {
            "lines": [
                "この程度の奴相手にしていると、きりが",
                "無いですわ。"
            ]
        },
        "69_0": {
            "lines": [
                "そうね。"
            ]
        },
        "70_0": {
            "lines": [
                "まったく、ふざけてるわね！"
            ]
        },
        "71_0": {
            "lines": [
                "夜に飛ぶ鳥を恐れた事は無いのかしら？"
            ]
        },
        "72_0": {
            "lines": [
                "フライドチキン、でしょ？",
                "私は人間がいいわ。"
            ]
        },
        "73_0": {
            "lines": [
                "（何が良いのかしら？）",
                "お嬢様、flyはフライドに変形しません。"
            ]
        },
        "74_0": {
            "lines": [
                "なんでもいいわ。",
                "私が本当の闇夜の恐怖を教えてあげる！"
            ]
        },
        "75_0": {
            "lines": [
                "闇夜の恐怖、ねぇ……"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "さぁ、咲夜。そいつをフライにするか、",
                "それとも先に進むか、どっちが良い？"
            ]
        },
        "61_0": {
            "lines": [
                "フライは後にして、先に進みましょう。",
                "夜は短いのですよ。"
            ]
        },
        "62_0": {
            "lines": [
                "そういえば、なんでこっちに向ってる",
                "んでしょうか？"
            ]
        },
        "63_0": {
            "lines": [
                "ん？、燃料補給。"
            ]
        },
        "64_0": {
            "lines": [
                "……"
            ]
        }
    }
}