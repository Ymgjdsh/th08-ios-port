{
    "0": {
        "60_0": {
            "lines": [
                "ああ、月が綺麗だな。"
            ]
        },
        "61_0": {
            "lines": [
                "えっ、あんたにはそう見えるの？"
            ]
        },
        "62_0": {
            "lines": [
                "ふん、綺麗じゃないか。",
                "こういう月ってなんていったっけ？待宵？"
            ]
        },
        "63_0": {
            "lines": [
                "呑気で良いわね。",
                "月見が楽しめて、人手が足りてたら……"
            ]
        },
        "64_0": {
            "lines": [
                "あんたなんか絶対に連れ出さないわよ。"
            ]
        },
        "64_1": {
            "lines": [
                "月の見える夜は楽しまないと駄目じゃない。"
            ]
        },
        "125_0": {
            "lines": [
                "ねぇ。お二方。"
            ]
        },
        "126_0": {
            "lines": [
                "楽しんでるぜ。私はな。"
            ]
        },
        "127_0": {
            "lines": [
                "あら、私も楽しんでるわよ。",
                "魔理沙、あなた以上はね。"
            ]
        },
        "128_0": {
            "lines": [
                "さっきといってる事が違うじゃん。"
            ]
        },
        "129_0": {
            "lines": [
                "違うの。",
                "私が楽しんでるのは月見じゃなくて、"
            ]
        },
        "130_0": {
            "lines": [
                "蛍見、だろう？"
            ]
        },
        "131_0": {
            "lines": [
                "惜しいわね。あなたにしては。"
            ]
        },
        "132_0": {
            "lines": [
                "……来ないのなら私から行くよ！"
            ]
        },
        "133_0": {
            "lines": [
                "蛍狩よ。"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "蛍狩って蛍を捕まえる事であって、",
                "やっつける事じゃないぜ。"
            ]
        },
        "61_0": {
            "lines": [
                "私は捕まえる気だったのに、あんたが",
                "潰したんでしょ？"
            ]
        },
        "62_0": {
            "lines": [
                "ったく、やれやれだぜ……"
            ]
        },
        "63_0": {
            "lines": [
                "私は蛍を避けただけだ。勘違いするな。"
            ]
        }
    }
}