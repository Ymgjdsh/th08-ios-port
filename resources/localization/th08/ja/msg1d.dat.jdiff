{
    "0": {
        "60_0": {
            "lines": [
                "さあ、出て来い！",
                "そこに隠れる闇に蠢くものよ。"
            ]
        },
        "61_0": {
            "lines": [
                "妖夢、おいてかないでよー…"
            ]
        },
        "62_0": {
            "lines": [
                "何言ってるんですか、夜は短いのですよ！"
            ]
        },
        "63_0": {
            "lines": [
                "早く敵を見つけて斬り潰すのです。"
            ]
        },
        "64_0": {
            "lines": [
                "いや、そうじゃなくて……。"
            ]
        },
        "65_0": {
            "lines": [
                "斬り潰すって……"
            ]
        },
        "125_0": {
            "lines": [
                "斬るか潰すかどっちかにしてよ！"
            ]
        },
        "126_0": {
            "lines": [
                "さぁ、斬られる前か潰される前に、",
                "どこに行けば良いのか言いなさい！"
            ]
        },
        "127_0": {
            "lines": [
                "妖夢のそれは、夜明けのテンションよ。"
            ]
        },
        "128_0": {
            "lines": [
                "おいてかないで、って言ったじゃない。",
                "まだ夜は始まったばっかよ。"
            ]
        },
        "129_0": {
            "lines": [
                "なんなのよ、こいつら。"
            ]
        },
        "130_0": {
            "lines": [
                "あれ？",
                "目の前に大きな蛍が居るわよ。"
            ]
        },
        "131_0": {
            "lines": [
                "気付いて無かったのですか……"
            ]
        },
        "132_0": {
            "lines": [
                "蛍見も良いわね。",
                "妖夢、寄り道していかない？"
            ]
        },
        "133_0": {
            "lines": [
                "今のどこにそんな時間があるのです！",
                "虫なんてこの楼観剣で……"
            ]
        },
        "134_0": {
            "lines": [
                "そうやって話している時間が一番長い！"
            ]
        },
        "135_0": {
            "lines": [
                "蛍様が出て喜ばない奴なんて、",
                "久しぶりに見たよ！"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "幽々子さまは、狙いを定めないから",
                "敵を討つのに時間がかかるのです。"
            ]
        },
        "61_0": {
            "lines": [
                "あら、急がば回れ、って言葉知ってる？"
            ]
        },
        "62_0": {
            "lines": [
                "あぁ、急いでるんでしたね。",
                "結局、次はどこに行けば良いのでしょうか？"
            ]
        },
        "63_0": {
            "lines": [
                "どう？",
                "この枝が倒れた方に進んでみない？"
            ]
        },
        "64_0": {
            "lines": [
                "そんなんでいいんですか……。"
            ]
        },
        "65_0": {
            "lines": [
                "って、そんなに傾けてたら、手を放す前に",
                "倒れる向きが決まっていますよ。"
            ]
        },
        "66_0": {
            "lines": [
                "くるくるくる～、っと。"
            ]
        }
    }
}