{
    "2": {
        "61_0": {
            "lines": [
                "お前達か。",
                "こんな真夜中に里を襲おうとする奴は。"
            ]
        },
        "62_0": {
            "lines": [
                "うにゃ。",
                "通りがかっただけだ。気にするな。"
            ]
        },
        "63_0": {
            "lines": [
                "ふん、妖怪の言う事なんか信用できないな。"
            ]
        },
        "64_0": {
            "lines": [
                "今夜を無かった事にしてやる！"
            ]
        }
    },
    "3": {
        "61_0": {
            "lines": [
                "お前達何もんだ？"
            ]
        },
        "62_0": {
            "lines": [
                "おっとそこは、",
                "やんごとなき事情を思い出した、だろ？"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "流石にこれ以上は下がれないな。"
            ]
        },
        "60_1": {
            "lines": [
                "さぁ、人間を明け渡して貰おうか。"
            ]
        },
        "61_0": {
            "lines": [
                "ちょっとちょっと魔理沙！"
            ]
        },
        "62_0": {
            "lines": [
                "誰が、人間をとって喰おうって言ったのよ。"
            ]
        },
        "63_0": {
            "lines": [
                "ふん。",
                "こんな里まで妖怪が来るようになるなんて。"
            ]
        },
        "64_0": {
            "lines": [
                "やはり異常な月の所為か。",
                "今まで、滅多に来る事は無かったんだがな。"
            ]
        },
        "65_0": {
            "lines": [
                "誰も人間をとって喰うなんて言ってないぜ。"
            ]
        },
        "66_0": {
            "lines": [
                "とにかく。",
                "私は急いでるの！"
            ]
        },
        "67_0": {
            "lines": [
                "あんたが誰だか知らないけど、人間なんか",
                "にかまっている暇は無いのよ。"
            ]
        },
        "68_0": {
            "lines": [
                "酷いぜ。"
            ]
        },
        "69_0": {
            "lines": [
                "大人しく通り過ぎてくれるなら、",
                "私も何もしまい。"
            ]
        },
        "70_0": {
            "lines": [
                "だが、お前達は少々騒々し過ぎる。"
            ]
        },
        "71_0": {
            "lines": [
                "ほら騒々しいって、魔理沙。"
            ]
        },
        "72_0": {
            "lines": [
                "真夜中だというのに、",
                "あんたが思いっきり魔法を使うからよ。"
            ]
        },
        "73_0": {
            "lines": [
                "何言ってるんだ？",
                "魔法は真夜中に思いっきり使うもんだぜ？"
            ]
        },
        "74_0": {
            "lines": [
                "太陽の下で人知れずこっそりと使うのは、",
                "日光写真ぐらいなもんだ。"
            ]
        },
        "75_0": {
            "lines": [
                "なにやら不穏な空気が漂っていたので",
                "里を遮断したが……"
            ]
        },
        "76_0": {
            "lines": [
                "どうやら正解のようだな。"
            ]
        },
        "77_0": {
            "lines": [
                "だからー。"
            ]
        },
        "78_0": {
            "lines": [
                "誰も人間を襲うなんていってない。"
            ]
        },
        "79_0": {
            "lines": [
                "（……明け渡せとか言ってなかったっけ？）"
            ]
        },
        "80_0": {
            "lines": [
                "むしろ目の前の人間に用事があるのだ！"
            ]
        },
        "81_0": {
            "lines": [
                "何でもいいよ、この与太郎が。"
            ]
        },
        "82_0": {
            "lines": [
                "里の人間にも里の歴史にも弾幕一本",
                "触れさせる物か！"
            ]
        },
        "83_0": {
            "lines": [
                "魔理沙！"
            ]
        },
        "84_0": {
            "lines": [
                "分かっていないと思うけど、",
                "こいつは人間じゃないわ。"
            ]
        },
        "85_0": {
            "lines": [
                "半獣よ。"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "満月が無くて変身出来ない半獣なんて、",
                "ただの人間だな。"
            ]
        },
        "61_0": {
            "lines": [
                "あんたもただの人間でしょ？"
            ]
        },
        "62_0": {
            "lines": [
                "満月さえあればこんな奴には……。"
            ]
        },
        "63_0": {
            "lines": [
                "そうそう。",
                "私たちは満月を取り戻そうとしているのよ。"
            ]
        },
        "64_0": {
            "lines": [
                "そうだ。",
                "最初から言ってただろ？"
            ]
        },
        "65_0": {
            "lines": [
                "あー？",
                "何だよそれ。聞いてない。"
            ]
        },
        "66_0": {
            "lines": [
                "あんたなら誰の仕業か知っていそうね。"
            ]
        },
        "67_0": {
            "lines": [
                "さぁ、私が勝ったんだから、約束通り",
                "教えて貰おうか。"
            ]
        },
        "68_0": {
            "lines": [
                "約束は今作ったが。"
            ]
        }
    }
}