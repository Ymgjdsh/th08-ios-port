{
    "0": {
        "60_0": {
            "lines": [
                "ちょ、ちょっと待って～！"
            ]
        },
        "60_1": {
            "lines": [
                "あー？"
            ]
        },
        "60_2": {
            "lines": [
                "こんな夜中に何処に行こうっての？"
            ]
        },
        "63_0": {
            "lines": [
                "毎年恒例の妖怪退治強化月間だ。",
                "妖怪の居る所なら何処にでも出かけるぜ。"
            ]
        },
        "63_1": {
            "lines": [
                "それは何？",
                "私に喧嘩を売ってるの？"
            ]
        },
        "65_0": {
            "lines": [
                "魔理沙が妖怪退治なんて滑稽だわ。"
            ]
        },
        "66_0": {
            "lines": [
                "おお？",
                "私の妖怪退治の腕を知らないのか？"
            ]
        },
        "67_0": {
            "lines": [
                "私が魔砲を放った後には、妖怪どころか",
                "人間も残らない。"
            ]
        },
        "67_1": {
            "lines": [
                "そこの人間。"
            ]
        },
        "68_0": {
            "lines": [
                "私の事、知らないのかしら。"
            ]
        },
        "69_0": {
            "lines": [
                "あー？"
            ]
        },
        "70_0": {
            "lines": [
                "夜の道で私を恐れない人間はいないわ。"
            ]
        },
        "71_0": {
            "lines": [
                "その気になれば、人間なんか全滅する",
                "位の多くの妖怪も呼べるわよ。"
            ]
        },
        "72_0": {
            "lines": [
                "……ふん、この夜雀風情が何を言うの。"
            ]
        },
        "73_0": {
            "lines": [
                "はっはっは～"
            ]
        },
        "74_0": {
            "lines": [
                "この私が誰だか知らないと見える。"
            ]
        },
        "75_0": {
            "lines": [
                "人間でしょ？"
            ]
        },
        "76_0": {
            "lines": [
                "人間。"
            ]
        },
        "77_0": {
            "lines": [
                "人間三昧。"
            ]
        },
        "78_0": {
            "lines": [
                "いやまぁ。"
            ]
        },
        "79_0": {
            "lines": [
                "いい？",
                "お前達は今夜から……"
            ]
        },
        "80_0": {
            "lines": [
                "夜は目が見えなくなるよ。"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "あー良く見える。",
                "どんな暗闇もばっちりだぜ。"
            ]
        },
        "61_0": {
            "lines": [
                "ああもう！",
                "こんな雑魚にかまってないで先急ぐわよ！"
            ]
        },
        "62_0": {
            "lines": [
                "それはそうと何処向ってるんだよ。",
                "そっちに敵が居るわけ無いだろ……"
            ]
        },
        "63_0": {
            "lines": [
                "でも、あっちの方から妖気を感じるのよ。"
            ]
        },
        "64_0": {
            "lines": [
                "そっちは人間しかいないぜ。",
                "私の様に善良な。"
            ]
        }
    }
}