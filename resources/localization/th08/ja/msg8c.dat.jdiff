{
    "2": {
        "60_0": {
            "lines": [
                "待っていたぞ。"
            ]
        },
        "140_0": {
            "lines": [
                "満月の夜にやってくるとはいい度胸だ。"
            ]
        },
        "230_0": {
            "lines": [
                "あら、すっかりお変わりになって"
            ]
        },
        "320_0": {
            "lines": [
                "あの人間には指一本触れさせない！"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "尋常じゃない攻撃だったけど、この程度じゃ",
                "肝試しにもならないわ。"
            ]
        },
        "61_0": {
            "lines": [
                "人間以外の者達同士で討ちあう丑三つ時。"
            ]
        },
        "62_0": {
            "lines": [
                "人間も妖怪も無い殺伐とした夜。"
            ]
        },
        "123_0": {
            "lines": [
                "こんな満月の夜だからかな？"
            ]
        },
        "124_0": {
            "lines": [
                "あいにく、私は人間よ。"
            ]
        },
        "125_0": {
            "lines": [
                "そう？",
                "でもね。あいにく私も人間なの。"
            ]
        },
        "126_0": {
            "lines": [
                "咲夜、丁度いいわ。",
                "こんな処で人間よ。"
            ]
        },
        "127_0": {
            "lines": [
                "丁度いいんですか？",
                "まだ、食事の時間には早いでしょう？"
            ]
        },
        "128_0": {
            "lines": [
                "そちらのお嬢さんは妖怪ね。",
                "そりゃその大きな羽を見れば判るけど。"
            ]
        },
        "129_0": {
            "lines": [
                "妖怪なんかと一緒にするな。",
                "私は誇り高き……。"
            ]
        },
        "130_0": {
            "lines": [
                "ここではそんなに誇り高く無い方が",
                "いいですよ。"
            ]
        },
        "131_0": {
            "lines": [
                "で、妖怪と人間の二人で何をしようと",
                "していたのかしら？"
            ]
        },
        "132_0": {
            "lines": [
                "いやまぁ、肝試しを……。"
            ]
        },
        "133_0": {
            "lines": [
                "肝試しぃ？"
            ]
        },
        "134_0": {
            "lines": [
                "人間と妖怪の二人で？"
            ]
        },
        "135_0": {
            "lines": [
                "こんな真実の満月の下、",
                "さらに草木だけが眠る丑三つ時に？"
            ]
        },
        "136_0": {
            "lines": [
                "悪い？　私達はちょっと季節はずれの",
                "納涼を楽しんでいただけよ。"
            ]
        },
        "137_0": {
            "lines": [
                "人間だったら大人しくお化けにでも",
                "なって私達を喜ばせればいいのよ。"
            ]
        },
        "138_0": {
            "lines": [
                "お嬢様。お化けになるんじゃなくて、",
                "お化けを演じるんですよ。人間は。"
            ]
        },
        "139_0": {
            "lines": [
                "魑魅魍魎の類なんて、沢山居るじゃない。"
            ]
        },
        "140_0": {
            "lines": [
                "何の為にわざわざ人間が演じる必要が",
                "あるのよ。"
            ]
        },
        "141_0": {
            "lines": [
                "お前。人間って言ったよね。"
            ]
        },
        "142_0": {
            "lines": [
                "では、何故妖怪を恐れない。"
            ]
        },
        "143_0": {
            "lines": [
                "何故私を畏れない。"
            ]
        },
        "144_0": {
            "lines": [
                "肝試しに来てるんだか、",
                "肝試させに来てるんだか……。"
            ]
        },
        "145_0": {
            "lines": [
                "でも、もう私に恐れる物は何一つない。"
            ]
        },
        "146_0": {
            "lines": [
                "いくら、目にも止まらぬ矢で",
                "打ち抜かれようと、"
            ]
        },
        "147_0": {
            "lines": [
                "いくら、里を一瞬で消す神の火で",
                "焼かれたとしても、"
            ]
        },
        "148_0": {
            "lines": [
                "私は死ぬ事は無い。"
            ]
        },
        "149_0": {
            "lines": [
                "もう肝試しも出来ないのよ。"
            ]
        },
        "150_0": {
            "lines": [
                "良かったですね、お嬢様。"
            ]
        },
        "151_0": {
            "lines": [
                "血吸い放題ですよ。",
                "吸っても死なないんでしょう？"
            ]
        },
        "152_0": {
            "lines": [
                "駄目だわ、咲夜。"
            ]
        },
        "153_0": {
            "lines": [
                "こいつはもう人間じゃないよ。",
                "私は私を恐れる人間の血しか飲まない。"
            ]
        },
        "154_0": {
            "lines": [
                "あら残念。無限にお酒の湧く瓢箪みたいかな、",
                "と思ったのですが。"
            ]
        },
        "155_0": {
            "lines": [
                "貴方、本当に人間？"
            ]
        },
        "156_0": {
            "lines": [
                "そんな訳で、肝試しだったらもう帰りなさい。",
                "ここは貴方達が来るような処じゃないわ。"
            ]
        },
        "157_0": {
            "lines": [
                "でもあいつは、何かあるような口ぶり",
                "だったわよね。"
            ]
        },
        "158_0": {
            "lines": [
                "あら、私には何かあるように見えるわよ。",
                "今と、ほんの少し先の未来に。"
            ]
        },
        "159_0": {
            "lines": [
                "咲夜は、ナイフは鋭く切れる割には鈍いのよ。"
            ]
        },
        "160_0": {
            "lines": [
                "輝夜はこいつを見つけさせる為に、肝試し",
                "を仕込んだに決まってるじゃない。絶対に。"
            ]
        },
        "161_0": {
            "lines": [
                "んー。",
                "かぐやだって？"
            ]
        },
        "162_0": {
            "lines": [
                "やっぱりそうか。人間と妖怪が肝試しだ",
                "なんておかしいと思ったよ。"
            ]
        },
        "163_0": {
            "lines": [
                "いつも私を始末しようとする。",
                "いつも刺客を遣わす。"
            ]
        },
        "164_0": {
            "lines": [
                "あいつは私が死なない事を知っているのに！"
            ]
        },
        "165_0": {
            "lines": [
                "蓬莱の薬を作ったのは輝夜でしょう？",
                "ふざけるのもいい加減にして欲しいわ。"
            ]
        },
        "166_0": {
            "lines": [
                "ほら、咲夜。",
                "私の言った通り、輝夜は私達を使ったのよ。"
            ]
        },
        "167_0": {
            "lines": [
                "ええ。つまり、お嬢様は面白そうだから",
                "話に乗ったと言う事ですね。"
            ]
        },
        "168_0": {
            "lines": [
                "ううん、暇だったからよ。"
            ]
        },
        "169_0": {
            "lines": [
                "肝試しの肝は富士の煙。",
                "月まで届く永遠の火山灰。"
            ]
        },
        "170_0": {
            "lines": [
                "不尽の火から生まれるは、",
                "何度でも甦る不死の鳥。"
            ]
        },
        "171_0": {
            "lines": [
                "甦るたびに強くなる伝説の火の鳥。",
                "今宵の弾は、お嬢ちゃんのトラウマになるよ。"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "あーれー。",
                "もーだめだぁ。"
            ]
        },
        "61_0": {
            "lines": [
                "あれ？",
                "もう降参？　口ほどにもないなぁ。"
            ]
        },
        "62_0": {
            "lines": [
                "私はもう十分ですよ～。",
                "死なない人間を挑発しないで下さい。"
            ]
        },
        "63_0": {
            "lines": [
                "そっか、咲夜は死ぬ人間だもんね。"
            ]
        },
        "64_0": {
            "lines": [
                "不吉な言い方ですわね。",
                "お嬢様が言うと冗談に聴こえませんわ。"
            ]
        },
        "65_0": {
            "lines": [
                "死なないって言っても、闘い続けるのは",
                "無理だ～。"
            ]
        },
        "66_0": {
            "lines": [
                "そう、咲夜も不老不死になってみない？"
            ]
        },
        "67_0": {
            "lines": [
                "そうすればずっと一緒に居られるよ。"
            ]
        },
        "68_0": {
            "lines": [
                "私は一生死ぬ人間ですよ。"
            ]
        },
        "69_0": {
            "lines": [
                "大丈夫、生きている間は一緒に居ますから。"
            ]
        },
        "70_0": {
            "lines": [
                "不老不死は止めた方がいいわよ。"
            ]
        },
        "71_0": {
            "lines": [
                "こう見えても、貴方に撃たれた体が物凄く",
                "痛いんだから。"
            ]
        },
        "72_0": {
            "lines": [
                "痛くても死ねないし。"
            ]
        },
        "73_0": {
            "lines": [
                "咲夜がそういうなら仕方が無い、残念ね。",
                "不老不死の……、蓬莱の薬はね、"
            ]
        },
        "74_0": {
            "lines": [
                "不老不死の人間の生き肝に溜まるのよ。"
            ]
        },
        "75_0": {
            "lines": [
                "目の前に不老不死になる薬が、疲れて",
                "痛がっているというのに。"
            ]
        },
        "76_0": {
            "lines": [
                "誰が人間の肝を食べるのですか。"
            ]
        },
        "77_0": {
            "lines": [
                "それに、誰からそんな事聞いたの？"
            ]
        },
        "78_0": {
            "lines": [
                "って聞かなくても判りそうなもんですが。"
            ]
        },
        "79_0": {
            "lines": [
                "人の肝がどうとか、なにやら物騒な会話を",
                "しているわね。"
            ]
        },
        "80_0": {
            "lines": [
                "これじゃぁ、私の肝試しじゃない。"
            ]
        },
        "81_0": {
            "lines": [
                "肝試しってそういう意味よね？",
                "ね、死ぬ咲夜。"
            ]
        },
        "82_0": {
            "lines": [
                "パチュリー様と一緒にいたら、変な覚え方",
                "ばっかして困りますわ。"
            ]
        }
    }
}