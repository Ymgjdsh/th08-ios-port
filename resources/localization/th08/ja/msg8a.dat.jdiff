{
    "2": {
        "60_0": {
            "lines": [
                "待っていたぞ。"
            ]
        },
        "140_0": {
            "lines": [
                "満月の夜にやってくるとはいい度胸だ。"
            ]
        },
        "230_0": {
            "lines": [
                "これが肝試しの肝？"
            ]
        },
        "320_0": {
            "lines": [
                "あの人間には指一本触れさせない！"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "なんだったのかしら。",
                "確かに妖精たちが騒いでいる様だけど……。"
            ]
        },
        "61_0": {
            "lines": [
                "今夜の月は、また一段と強い。"
            ]
        },
        "62_0": {
            "lines": [
                "妖の者が騒ぐのも無理が無いわね。"
            ]
        },
        "123_0": {
            "lines": [
                "こんな夜に出かける馬鹿者も居るんだねぇ。"
            ]
        },
        "124_0": {
            "lines": [
                "誰？"
            ]
        },
        "125_0": {
            "lines": [
                "お前だよ。"
            ]
        },
        "126_0": {
            "lines": [
                "いや馬鹿者の事じゃなくて。"
            ]
        },
        "127_0": {
            "lines": [
                "馬鹿者ってところは認めるのね。"
            ]
        },
        "128_0": {
            "lines": [
                "私はずっとここに住んでいる人間。",
                "今ここに居るのは馬鹿だからじゃないよ。"
            ]
        },
        "129_0": {
            "lines": [
                "人間？",
                "人間ねぇ。"
            ]
        },
        "130_0": {
            "lines": [
                "この竹林の持ち主か何かかしら。"
            ]
        },
        "131_0": {
            "lines": [
                "で、目的は何？　お馬鹿さん。"
            ]
        },
        "132_0": {
            "lines": [
                "肝試し。"
            ]
        },
        "133_0": {
            "lines": [
                "肝とか色々試し。"
            ]
        },
        "134_0": {
            "lines": [
                "なんと肝試し！"
            ]
        },
        "135_0": {
            "lines": [
                "ああ、何時から人間はこんなに馬鹿に",
                "なったのかしら？"
            ]
        },
        "136_0": {
            "lines": [
                "こんなに狂おしい満月の丑三つ時に、"
            ]
        },
        "137_0": {
            "lines": [
                "こんなに妖怪が沢山出る処まで来て、"
            ]
        },
        "138_0": {
            "lines": [
                "事もあろうか肝試し！"
            ]
        },
        "139_0": {
            "lines": [
                "妖怪に殺されなかったのが不思議ね。"
            ]
        },
        "140_0": {
            "lines": [
                "それに死んだら、妖怪達に生き肝を",
                "喰われる肝試しなんて――"
            ]
        },
        "141_0": {
            "lines": [
                "言われ放題よ。",
                "霊夢、何か反撃しないの？"
            ]
        },
        "142_0": {
            "lines": [
                "いやまぁねぇ。肝試しったって、",
                "輝夜がほれいけ、やれいけって言うからさぁ。"
            ]
        },
        "143_0": {
            "lines": [
                "今なんて？",
                "輝夜って言った？"
            ]
        },
        "144_0": {
            "lines": [
                "言ったっけ？"
            ]
        },
        "145_0": {
            "lines": [
                "か・ぐ・や、言ったわ。"
            ]
        },
        "146_0": {
            "lines": [
                "むきー！",
                "肝試しなんておかしいと思ったら、"
            ]
        },
        "147_0": {
            "lines": [
                "やっぱりあいつの仕業なのね。"
            ]
        },
        "148_0": {
            "lines": [
                "そうか、今度はこいつ等をけしかけて",
                "私を始末しようとしているな？"
            ]
        },
        "149_0": {
            "lines": [
                "あいつったら、いっつもいっつも私を",
                "始末しようとして！"
            ]
        },
        "150_0": {
            "lines": [
                "全く、こんな不便な体にしたのは",
                "あいつじゃないの！"
            ]
        },
        "151_0": {
            "lines": [
                "なんか、一人で盛り上がってるわね。"
            ]
        },
        "152_0": {
            "lines": [
                "ほら貴方も便乗しないと損よ。"
            ]
        },
        "153_0": {
            "lines": [
                "ふん、輝夜の使いがどれほどのもん",
                "なのか見せて貰おうか。"
            ]
        },
        "154_0": {
            "lines": [
                "あいつが遣したって事は、あいつよりは",
                "強いんでしょ？"
            ]
        },
        "155_0": {
            "lines": [
                "強気な人間ね。私みたいな妖怪相手に",
                "そこまで強気な人間なんて、"
            ]
        },
        "156_0": {
            "lines": [
                "３人位しか知らないわ。"
            ]
        },
        "157_0": {
            "lines": [
                "でも、人間相手に戦うのはちょっと",
                "気乗りしないわね……"
            ]
        },
        "158_0": {
            "lines": [
                "何言ってるの。",
                "魔理沙は余裕でのして来たじゃないの。"
            ]
        },
        "159_0": {
            "lines": [
                "私を普通の人間だと思うな。"
            ]
        },
        "160_0": {
            "lines": [
                "私は死なない。絶対に死ぬ事が無い。",
                "あのにっくき輝夜の所為で。"
            ]
        },
        "161_0": {
            "lines": [
                "そうよ、いくらあいつが私を始末しようと",
                "しても、どだい無理な事。"
            ]
        },
        "162_0": {
            "lines": [
                "あいつはそれが判ってて使いを遣して来る。",
                "腹立たしいにも程があるわ。"
            ]
        },
        "163_0": {
            "lines": [
                "ほら、霊夢。",
                "また乗り遅れてるわよ。"
            ]
        },
        "164_0": {
            "lines": [
                "よく分からないけど。"
            ]
        },
        "165_0": {
            "lines": [
                "死なないって事は、",
                "思いっきりやってもいいって事？"
            ]
        },
        "166_0": {
            "lines": [
                "中正解ね。",
                "絶対に死なないのが自慢みたいだし。"
            ]
        },
        "167_0": {
            "lines": [
                "思いっきりやらなきゃ、",
                "貴方の人生ゲームオーバー。"
            ]
        },
        "168_0": {
            "lines": [
                "もう戻り橋にも戻れない、",
                "一方通行の丑三つ時。"
            ]
        },
        "169_0": {
            "lines": [
                "お望みどおり。",
                "貴方達の肝、試させて貰うわよ。"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "あーれー。",
                "強すぎるぅぅ。"
            ]
        },
        "61_0": {
            "lines": [
                "あらほんと、まだ生きているわ。",
                "ほんとに死なないのね。"
            ]
        },
        "62_0": {
            "lines": [
                "最初は何度も死にかけて頼りないから",
                "びっくりしたわよ。ほんと。"
            ]
        },
        "63_0": {
            "lines": [
                "痛い痛い、死なないけど痛い～。"
            ]
        },
        "64_0": {
            "lines": [
                "霊夢、この娘面白いわ。"
            ]
        },
        "65_0": {
            "lines": [
                "いや、痛がってるのを見て面白い言うのは",
                "ちょっと。"
            ]
        },
        "66_0": {
            "lines": [
                "こんなに強いんじゃ、肝試しもへったくれも",
                "無いじゃない。"
            ]
        },
        "67_0": {
            "lines": [
                "そう？",
                "私だって怖い物も色々あるわよ。"
            ]
        },
        "68_0": {
            "lines": [
                "まんじゅうとかでしょ？"
            ]
        },
        "69_0": {
            "lines": [
                "そう、あの丸いフォルムが大きな蟲の卵を",
                "彷彿させて、そして中のあんが……"
            ]
        },
        "70_0": {
            "lines": [
                "いやぁぁ。まんじゅう怖い。"
            ]
        },
        "71_0": {
            "lines": [
                "それはともかく、肝試しはこれで終了かしら？"
            ]
        },
        "72_0": {
            "lines": [
                "あれ？",
                "そう言えばまだ肝を試していないわね。"
            ]
        },
        "73_0": {
            "lines": [
                "？"
            ]
        },
        "74_0": {
            "lines": [
                "ほら、目の前の人間の生き肝。",
                "霊夢、貴方が掻っ捌いて確認しなさい。"
            ]
        },
        "75_0": {
            "lines": [
                "ひぇぇ。",
                "死なないけど怖い。"
            ]
        },
        "76_0": {
            "lines": [
                "なんで私がそんな妖怪じみたことしなきゃ",
                "いけないのかしら？"
            ]
        },
        "77_0": {
            "lines": [
                "あら、不老不死の人間の生き肝を食せば、",
                "貴方も不老不死になれるわよ。"
            ]
        },
        "78_0": {
            "lines": [
                "というか、人間やめるのは",
                "ちょっとねぇ……"
            ]
        },
        "79_0": {
            "lines": [
                "あら酷い。私は人間じゃないって言うの？"
            ]
        },
        "80_0": {
            "lines": [
                "人間……、なのかな？",
                "よく分からないわね。"
            ]
        },
        "81_0": {
            "lines": [
                "まぁどうせ、今の幻想郷は人間なのか",
                "違うのか判らないような連中ばかりよ。"
            ]
        },
        "82_0": {
            "lines": [
                "いまさら、魂を入れる器の違いなんて",
                "大したもんじゃないのかな？"
            ]
        },
        "83_0": {
            "lines": [
                "でも博麗の仕事は妖怪退治。",
                "それは妖怪差別かしら？"
            ]
        },
        "84_0": {
            "lines": [
                "前言撤回。妖怪は退治されるもの。",
                "人間は退治するもの。"
            ]
        },
        "85_0": {
            "lines": [
                "これは動かせない約束事ね。",
                "これからも私は、妖怪を退治するわ。"
            ]
        },
        "86_0": {
            "lines": [
                "大・正・解。"
            ]
        }
    }
}