{
    "0": {
        "60_0": {
            "lines": [
                "遅かったわね。"
            ]
        },
        "121_0": {
            "lines": [
                "全ての扉は封印したわ。",
                "もう、姫は連れ出せないでしょう？"
            ]
        },
        "121_1": {
            "lines": [
                "漸く見つかりましたね。犯人が。"
            ]
        },
        "122_0": {
            "lines": [
                "これは宇宙鳥。",
                "まだまだ、焦っちゃ駄目よ。"
            ]
        },
        "123_0": {
            "lines": [
                "なんだ、幽霊か。",
                "焦らせないでよ、もう。"
            ]
        },
        "124_0": {
            "lines": [
                "用が無いなら帰ってよ。",
                "今取り込み中なの。"
            ]
        },
        "125_0": {
            "lines": [
                "そうはいかない。",
                "この月の異変は、お前がやったのだろう？"
            ]
        },
        "126_0": {
            "lines": [
                "そうなら斬る。",
                "違うのなら斬って先に進む。"
            ]
        },
        "127_0": {
            "lines": [
                "月の異変？",
                "ああ、地上の密室の術の事？"
            ]
        },
        "128_0": {
            "lines": [
                "そうよ。",
                "これは物凄く迷惑な術だわ。"
            ]
        },
        "129_0": {
            "lines": [
                "即刻やめてもらいます。",
                "妖夢、さぁ斬っておしまい。"
            ]
        },
        "130_0": {
            "lines": [
                "え、えぇ、行きますよ？"
            ]
        },
        "131_0": {
            "lines": [
                "荒っぽい幽霊ね。",
                "少しは話を聞いてからでも良いじゃない。"
            ]
        },
        "191_0": {
            "lines": [
                "あら、お迎えかと思ったら、幽霊？"
            ]
        },
        "192_0": {
            "lines": [
                "まぁ、お迎えが来れる筈が無いけど。"
            ]
        },
        "193_0": {
            "lines": [
                "妖夢、二人目よ。",
                "これも斬るのよ。"
            ]
        },
        "194_0": {
            "lines": [
                "え、えぇ？行きます、の？"
            ]
        },
        "195_0": {
            "lines": [
                "ほら、そんなに苛めちゃ可哀相じゃない。"
            ]
        },
        "196_0": {
            "lines": [
                "月の件は、私の術よ。",
                "ただ、これも姫とこの娘の為。"
            ]
        },
        "197_0": {
            "lines": [
                "幽霊とはいえ、この位の優しさが無いと",
                "いけないわ。"
            ]
        },
        "198_0": {
            "lines": [
                "お前が犯人か。",
                "それは斬る相手が一人減った。"
            ]
        },
        "199_0": {
            "lines": [
                "うーん、でも焦っちゃ駄目。",
                "ウドンゲ、ここはお前に任せたわ。"
            ]
        },
        "200_0": {
            "lines": [
                "間違っても姫を連れ出されないようにね。"
            ]
        },
        "261_0": {
            "lines": [
                "お任せください。斬られはしないけど、",
                "扉は一つも空かせません。"
            ]
        },
        "262_0": {
            "lines": [
                "（なんだ、幽々子さまと大差ないじゃ",
                "　ないか。）"
            ]
        },
        "263_0": {
            "lines": [
                "脳が逃げて、鳥が残る。",
                "妖夢、斬る相手が一人減ったわね。"
            ]
        },
        "264_0": {
            "lines": [
                "え？　えぇ、斬りますってば。"
            ]
        },
        "265_0": {
            "lines": [
                "ふふふ。",
                "月の事ばっかに気を取られて……。"
            ]
        },
        "266_0": {
            "lines": [
                "既に私の罠に嵌っている事に気が付いて",
                "いないのかしら？"
            ]
        },
        "267_0": {
            "lines": [
                "！？"
            ]
        },
        "268_0": {
            "lines": [
                "貴方の方向は狂い始めている。",
                "もう真っ直ぐ飛んでいられない！"
            ]
        },
        "269_0": {
            "lines": [
                "そういえば、幽々子さま、なんで",
                "あいつが鳥なんですか？兎じゃぁ…"
            ]
        },
        "270_0": {
            "lines": [
                "兎は、皮をはいで食べると、",
                "鳥になるの。覚えておきなさい。"
            ]
        },
        "271_0": {
            "lines": [
                "嘘を教えるな。",
                "っつか、無視するな！"
            ]
        },
        "272_0": {
            "lines": [
                "私の目を見ても、まだ正気で居られると",
                "思うなよ！"
            ]
        }
    },
    "3": {
        "180_0": {
            "lines": [
                "幽々子さまの言う通りに進む（FinalA）",
                "幽々子さまの言う通りに進む（FinalB）"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "うう。目が廻る。",
                "なんだか気分が悪くなってきた……。"
            ]
        },
        "61_0": {
            "lines": [
                "あらあら、これだけ揺られたから、",
                "人間側が酔ったのね。"
            ]
        },
        "62_0": {
            "lines": [
                "まぁ、安心しなさい。",
                "次は体に良い物が食べられるわよ。"
            ]
        },
        "63_0": {
            "lines": [
                "なんていうこと。",
                "思ってたよりずっと強い……。"
            ]
        },
        "64_0": {
            "lines": [
                "次は薬膳よ。しかも最後なの。"
            ]
        },
        "65_0": {
            "lines": [
                "龍じゃないのが残念だけど。"
            ]
        },
        "66_0": {
            "lines": [
                "幽々子さま。",
                "なんか知っているんですか？"
            ]
        },
        "67_0": {
            "lines": [
                "全然。"
            ]
        }
    },
    "2": {
        "60_0": {
            "lines": [
                "うう。目が廻る。",
                "なんだか気分が悪くなってきた……。"
            ]
        },
        "61_0": {
            "lines": [
                "あらあら、これだけ揺られたから、",
                "人間側が酔ったのね。"
            ]
        },
        "62_0": {
            "lines": [
                "あそこに見える扉の奥で",
                "ちょっと休みましょうか。"
            ]
        },
        "63_0": {
            "lines": [
                "ああ、しまった。",
                "まだ封印が間に合ってない扉があったのか。"
            ]
        },
        "64_0": {
            "lines": [
                "大丈夫、ですよ。",
                "先を急ぎましょう。さっきのを追いますよ。"
            ]
        },
        "65_0": {
            "lines": [
                "いいの。",
                "空いている扉は入れる扉。"
            ]
        },
        "66_0": {
            "lines": [
                "きっとそこには最後の料理が待っているわ。"
            ]
        },
        "67_0": {
            "lines": [
                "まぁ、休憩にはならないかもしれない",
                "けどね。"
            ]
        }
    }
}