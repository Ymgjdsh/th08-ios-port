{
    "0": {
        "60_0": {
            "lines": [
                "ちょ、ちょっと待って～！"
            ]
        },
        "61_0": {
            "lines": [
                "あんた邪魔だって。"
            ]
        },
        "61_1": {
            "lines": [
                "あなた達には私の歌声が届かないのかしら？"
            ]
        },
        "62_0": {
            "lines": [
                "もしかして人間じゃ無いの？"
            ]
        },
        "64_0": {
            "lines": [
                "夜だというのに、雀の鳴き声がするわ。妖夢。"
            ]
        },
        "64_1": {
            "lines": [
                "幽々子さま。",
                "この鳴き声に惑わされないで下さい。"
            ]
        },
        "65_0": {
            "lines": [
                "これは夜雀の鳴き声。",
                "最も不吉な音です。"
            ]
        },
        "66_0": {
            "lines": [
                "不吉なんて失礼ね。"
            ]
        },
        "67_0": {
            "lines": [
                "それに、幽霊が出る音よりはなんぼか",
                "マシでしょ？"
            ]
        },
        "69_0": {
            "lines": [
                "ええそうねぇ、比べ物になりませんわ。"
            ]
        },
        "69_1": {
            "lines": [
                "否定して下さいよ～。"
            ]
        },
        "70_0": {
            "lines": [
                "妖夢ほら、鳴き声がまた強くなってきたわ。",
                "何処から聞こえてるのかしら。"
            ]
        },
        "71_0": {
            "lines": [
                "ああもう、人間でも人間だった奴でもいいや"
            ]
        },
        "72_0": {
            "lines": [
                "これから、楽しい妖怪祭りが始まるよ。"
            ]
        },
        "73_0": {
            "lines": [
                "さぁ妖夢、先を急ぎましょうか。"
            ]
        },
        "74_0": {
            "lines": [
                "え？えぇ、そうですね。そうですけど。",
                "それにはまず、目の前の鳥を落とさないと。"
            ]
        },
        "75_0": {
            "lines": [
                "雀は小骨が多くて嫌いなの。"
            ]
        },
        "76_0": {
            "lines": [
                "通すもんか！"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "夜雀が出たって事は、じきに妖怪か何か",
                "が集まってきます。"
            ]
        },
        "61_0": {
            "lines": [
                "その前にここを去りましょう。",
                "先を急ぎますよ。"
            ]
        },
        "62_0": {
            "lines": [
                "ちょっと待って。小骨が……"
            ]
        },
        "63_0": {
            "lines": [
                "さっき、嫌いって言ってたじゃないですか。"
            ]
        },
        "64_0": {
            "lines": [
                "妖夢、好き嫌いは良くないわ。"
            ]
        }
    }
}