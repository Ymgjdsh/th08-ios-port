{
    "0": {
        "60_0": {
            "lines": [
                "ほら何も無いじゃないの！"
            ]
        },
        "61_0": {
            "lines": [
                "まだ、夜は始まったばっかよ。",
                "焦らないの。"
            ]
        },
        "62_0": {
            "lines": [
                "焦って私を連れ出しておいて",
                "焦らないも何も無いでしょ？"
            ]
        },
        "63_0": {
            "lines": [
                "報酬は高く付くから覚えときなさい。"
            ]
        },
        "63_1": {
            "lines": [
                "って、さっきから何にも無いって……",
                "私が居たでしょ！"
            ]
        },
        "124_h1_0": {
            "lines": [
                "　闇に蠢く光の虫　"
            ]
        },
        "125_0": {
            "lines": [
                "心配しなくても……"
            ]
        },
        "126_0": {
            "lines": [
                "報酬は払うわよ。",
                "あなたじゃあるまいし。"
            ]
        },
        "127_0": {
            "lines": [
                "ちょっとちょっとちょっと。"
            ]
        },
        "128_0": {
            "lines": [
                "私を無視するとはいい度胸だわ。"
            ]
        },
        "129_0": {
            "lines": [
                "それなりの覚悟が出来てるんでしょうね！"
            ]
        },
        "130_0": {
            "lines": [
                "洒落かしら？"
            ]
        },
        "131_0": {
            "lines": [
                "洒落なの？"
            ]
        },
        "132_0": {
            "lines": [
                "そう言えば、夜に出歩くのに",
                "大事な物置いて来ちゃった。神社に。"
            ]
        },
        "133_0": {
            "lines": [
                "？"
            ]
        },
        "134_0": {
            "lines": [
                "あなたの言いたい事は判ったわ。",
                "蚊取り線香でしょ？"
            ]
        },
        "135_0": {
            "lines": [
                "蛍だってば！"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "ほんと、夜は虫が多くて嫌よねぇ。"
            ]
        },
        "61_0": {
            "lines": [
                "夜しか起きていない奴が何を言うのよ。"
            ]
        },
        "62_0": {
            "lines": [
                "ええ、夜の方が自然が豊かってことよ。"
            ]
        },
        "63_0": {
            "lines": [
                "最近、蛍も増えたわね……",
                "何だか外の世界がちょっと心配だわ。"
            ]
        },
        "64_0": {
            "lines": [
                "判ってるじゃないの。",
                "でも、心配するなんてあなたらしくないわ。"
            ]
        }
    }
}