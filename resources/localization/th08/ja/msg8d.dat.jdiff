{
    "2": {
        "60_0": {
            "lines": [
                "待っていたぞ。"
            ]
        },
        "140_0": {
            "lines": [
                "満月の夜にやってくるとはいい度胸だ。"
            ]
        },
        "230_0": {
            "lines": [
                "……肝試しでも、お前は怖くない！"
            ]
        },
        "320_0": {
            "lines": [
                "あの人間には指一本触れさせない！"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "急に……、攻撃が止んだ。",
                "こういうときが一番怖いです。"
            ]
        },
        "61_0": {
            "lines": [
                "一際異彩を放つ、幽霊の姿。"
            ]
        },
        "62_0": {
            "lines": [
                "こんな満月の下の草木も眠る丑三つ時。"
            ]
        },
        "123_0": {
            "lines": [
                "幽霊は珍しくは無いけど、その確かな形、",
                "目立つわね。"
            ]
        },
        "124_0": {
            "lines": [
                "うわ、出た！"
            ]
        },
        "125_0": {
            "lines": [
                "妖夢、出たわよ。"
            ]
        },
        "126_0": {
            "lines": [
                "幽霊に、出た、言われてもねぇ。"
            ]
        },
        "127_0": {
            "lines": [
                "……。"
            ]
        },
        "128_0": {
            "lines": [
                "なんだ、人間か。",
                "間違って斬るところでしたよ。"
            ]
        },
        "129_0": {
            "lines": [
                "って、こんな時間に人間？",
                "やっぱり不自然よ！"
            ]
        },
        "130_0": {
            "lines": [
                "………。"
            ]
        },
        "131_0": {
            "lines": [
                "私は最初からここに住んでいるの。",
                "時間はともかく、貴方達よりは自然だわ。"
            ]
        },
        "132_0": {
            "lines": [
                "で、貴方達は何の用かしら。"
            ]
        },
        "133_0": {
            "lines": [
                "私達は肝試しに――って、幽々子さま？"
            ]
        },
        "134_0": {
            "lines": [
                "妖夢、そいつに近づいてはいけない。"
            ]
        },
        "135_0": {
            "lines": [
                "幽々子さま……。"
            ]
        },
        "136_0": {
            "lines": [
                "そいつは、他の人間とは違う。"
            ]
        },
        "137_0": {
            "lines": [
                "触れてはいけない。",
                "その呪いで穢れてしまう。"
            ]
        },
        "138_0": {
            "lines": [
                "食してはいけない。",
                "その毒で呪われてしまう。"
            ]
        },
        "139_0": {
            "lines": [
                "何より……。",
                "私の術が効かない。"
            ]
        },
        "140_0": {
            "lines": [
                "なんか、酷く嫌われてるようね。",
                "初対面なのに。"
            ]
        },
        "141_0": {
            "lines": [
                "それに、いきなり術って、何をかけようと",
                "したのかしら。"
            ]
        },
        "142_0": {
            "lines": [
                "幽々子さまは、人間を死なす事が出来る。",
                "それが効かないというのは――"
            ]
        },
        "143_0": {
            "lines": [
                "いきなり取り殺そうとしたの？",
                "物騒な幽霊ね。"
            ]
        },
        "144_0": {
            "lines": [
                "お前は人間ではないな？"
            ]
        },
        "145_0": {
            "lines": [
                "って、それじゃ幽々子さまが怯えている",
                "理由が判らないけど。"
            ]
        },
        "146_0": {
            "lines": [
                "あいにくだけど、人間よ。",
                "ただちょっと死なないだけ。"
            ]
        },
        "147_0": {
            "lines": [
                "蓬莱人……。",
                "怖いわ、妖夢。"
            ]
        },
        "148_0": {
            "lines": [
                "肝試しに来るまではあれほど平気だった",
                "のに……、何か変な物でも食べました？"
            ]
        },
        "149_0": {
            "lines": [
                "まぁ、この場は私が何とかします。"
            ]
        },
        "150_0": {
            "lines": [
                "怖いもん無しの幽々子さまが、こんなに",
                "怯えるものがあるなんて思わなかった。"
            ]
        },
        "151_0": {
            "lines": [
                "幽霊と私では、相性が良くないのかな？"
            ]
        },
        "152_0": {
            "lines": [
                "なんだか腹が立ってきたよ。",
                "もう攻撃開始しようかな～。"
            ]
        },
        "153_0": {
            "lines": [
                "でも、何をそんなに怯えてるんですか？",
                "幽々子さま。"
            ]
        },
        "154_0": {
            "lines": [
                "蓬莱の薬を飲んだ人間は不老不死になる。"
            ]
        },
        "155_0": {
            "lines": [
                "その不老不死の人間の生き肝を食すと、"
            ]
        },
        "156_0": {
            "lines": [
                "その人も不老不死になる。"
            ]
        },
        "157_0": {
            "lines": [
                "その生き肝を亡霊が食すと……？"
            ]
        },
        "158_0": {
            "lines": [
                "死ねない亡霊が生まれるわ。"
            ]
        },
        "159_0": {
            "lines": [
                "そして、蓬莱の輪廻は終る。",
                "成仏も転生も出来ないし、薬も続かない。"
            ]
        },
        "160_0": {
            "lines": [
                "まぁ食べなければいいんだけどね。"
            ]
        },
        "161_0": {
            "lines": [
                "じゃあ食べるなー！"
            ]
        },
        "162_0": {
            "lines": [
                "全く、ふざけた幽霊達ね。"
            ]
        },
        "163_0": {
            "lines": [
                "もしかしたら、幽霊になるとこんなに",
                "おかしくなるのかしら？"
            ]
        },
        "164_0": {
            "lines": [
                "死ねない私には確かめ様がないわね。"
            ]
        },
        "165_0": {
            "lines": [
                "心配した私が馬鹿でした。",
                "幽々子さまはやっぱり幽々子さまですね。"
            ]
        },
        "166_0": {
            "lines": [
                "食べるかもしれないよ～。",
                "目の前の不老不死の生き肝、美味しそうね。"
            ]
        },
        "167_0": {
            "lines": [
                "幽々子さまの手の届かない処で始末します。"
            ]
        },
        "168_0": {
            "lines": [
                "果たして、死人が私を斬る事が出来るかしら？"
            ]
        },
        "169_0": {
            "lines": [
                "仲間を増やす事は出来ないかもしれないけど、",
                "本当に死なないのか試させてもらうよ。"
            ]
        },
        "170_0": {
            "lines": [
                "成仏を忘れた亡霊は新たな生を生まない。",
                "死ねない人間は色鮮やかな冥界を知らない。"
            ]
        },
        "171_0": {
            "lines": [
                "生まれ生まれ生まれ生まれて生の始めに暗く",
                "死に死に死に、死んで死の終わりに冥し"
            ]
        },
        "172_0": {
            "lines": [
                "死を知らない私は闇を超越する。",
                "暗い輪廻から解き放たれた美しい弾幕を見よ！"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "なんてこと！",
                "もう体力の限界が……。"
            ]
        },
        "61_0": {
            "lines": [
                "不老不死でも体力には限りがあるのですね。"
            ]
        },
        "62_0": {
            "lines": [
                "さぁ、相手の動きが鈍くなってきたわ。",
                "今よ！"
            ]
        },
        "63_0": {
            "lines": [
                "何の今ですか！",
                "食べないんでしょ！"
            ]
        },
        "64_0": {
            "lines": [
                "死ねなくても、闘い続ける事は出来ないわ。",
                "体のあちこちが痛い。"
            ]
        },
        "65_0": {
            "lines": [
                "亡霊はいいわよ。",
                "体は痛まないし。貴方もどう？　亡霊は。"
            ]
        },
        "66_0": {
            "lines": [
                "人の話聞いてました？"
            ]
        },
        "67_0": {
            "lines": [
                "死なない人間は面白いですね。",
                "力一杯闘ってもいいという安心感があって。"
            ]
        },
        "68_0": {
            "lines": [
                "あら、貴方いつも手を抜いているのかしら？"
            ]
        },
        "69_0": {
            "lines": [
                "いえ、滅相も無いです。"
            ]
        },
        "70_0": {
            "lines": [
                "それにしても、強い。",
                "何でそんなに強いのよ。"
            ]
        },
        "71_0": {
            "lines": [
                "みんな私より年下でしょう？"
            ]
        },
        "72_0": {
            "lines": [
                "人間には強さの限界があるからに",
                "決まってるじゃない。"
            ]
        },
        "73_0": {
            "lines": [
                "貴方は、いくら頑張っても幽霊に勝てない。"
            ]
        },
        "74_0": {
            "lines": [
                "幽霊はあんまり関係無いと思いますが、",
                "むしろこっちは二人で闘ってい……"
            ]
        },
        "75_0": {
            "lines": [
                "あら、目の前に不老不死の生き肝が。",
                "珍しいわね。"
            ]
        },
        "76_0": {
            "lines": [
                "幽々子さま～。"
            ]
        },
        "77_0": {
            "lines": [
                "しょうがない。"
            ]
        },
        "78_0": {
            "lines": [
                "もう痛くて動けないし、",
                "煮るなり焼くなり好きにしな！"
            ]
        },
        "79_0": {
            "lines": [
                "煮ても焼いても駄目よ！"
            ]
        },
        "80_0": {
            "lines": [
                "肝は、生で食すのよ。",
                "煮ても焼いても蓬莱の効力は無くなるわ。"
            ]
        },
        "81_0": {
            "lines": [
                "じゃあ、焼きましょう。"
            ]
        },
        "82_0": {
            "lines": [
                "焼かれても死なないけどね。",
                "ちょっと熱いだけ……、しくしく。"
            ]
        },
        "83_0": {
            "lines": [
                "ところで、何でこんなことになったん",
                "だったっけ？"
            ]
        },
        "84_0": {
            "lines": [
                "貴方が肝試しに行く嵌めになったって",
                "誘ったんじゃないの。"
            ]
        },
        "85_0": {
            "lines": [
                "ああ、それでですか。"
            ]
        },
        "86_0": {
            "lines": [
                "だからさっきから生き肝、生き肝、",
                "言ってたんですか。"
            ]
        },
        "87_0": {
            "lines": [
                "肝試しは途中で中止です。",
                "輝夜に騙されたのが判ったから。"
            ]
        },
        "88_0": {
            "lines": [
                "輝夜は明らかに、この人間と戦わせたがって",
                "いたんですよ。肝試しなんて嘘もいいところ。"
            ]
        },
        "89_0": {
            "lines": [
                "中止？中断でしょ？",
                "肝試しはこれから再開するわよ。"
            ]
        },
        "90_0": {
            "lines": [
                "えー……",
                "実は私、怖い物苦手なんですよぉ。"
            ]
        },
        "91_0": {
            "lines": [
                "ほらあそこの竹の下に幽霊が……。"
            ]
        },
        "92_0": {
            "lines": [
                "ひえぇぇぇ。"
            ]
        }
    }
}