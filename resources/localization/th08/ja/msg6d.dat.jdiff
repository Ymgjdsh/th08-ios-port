{
    "2": {
        "60_0": {
            "lines": [
                "ふふふ。"
            ]
        },
        "61_0": {
            "lines": [
                "無事ついて来てるようね。"
            ]
        },
        "62_0": {
            "lines": [
                "追いついた。",
                "もう逃さないわよ。"
            ]
        },
        "63_0": {
            "lines": [
                "ええ、逃しませんとも。"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "えぇーと。",
                "何処にいった？"
            ]
        },
        "121_0": {
            "lines": [
                "ここ、ここ。"
            ]
        },
        "122_0": {
            "lines": [
                "さすが半人前ね。",
                "こんな短時間で見失うなんて。"
            ]
        },
        "123_0": {
            "lines": [
                "何やってるのよ。",
                "その大きな半幽霊は何の為についているの？"
            ]
        },
        "124_0": {
            "lines": [
                "尾行の為じゃ無いですよ。"
            ]
        },
        "125_0": {
            "lines": [
                "まぁ、ここは私が作った偽の通路。"
            ]
        },
        "126_0": {
            "lines": [
                "貴方達が見失うのも無理は無いわ。"
            ]
        },
        "127_0": {
            "lines": [
                "偽の通路？"
            ]
        },
        "128_0": {
            "lines": [
                "偽の月に偽の星空。"
            ]
        },
        "129_0": {
            "lines": [
                "ほんと、手の込んだ事をしたものね。"
            ]
        },
        "130_0": {
            "lines": [
                "あら、よく分かったわね。",
                "あの月が幻影だって。"
            ]
        },
        "131_0": {
            "lines": [
                "大昔の月よ、あれは。",
                "月がまだ天上にあった頃の月。"
            ]
        },
        "132_0": {
            "lines": [
                "昔ですか？"
            ]
        },
        "133_0": {
            "lines": [
                "古臭い、黴の生えた月。"
            ]
        },
        "134_0": {
            "lines": [
                "今の月には兎はいないものねぇ。"
            ]
        },
        "135_0": {
            "lines": [
                "あいにく、今でも兎はいるわ。"
            ]
        },
        "136_0": {
            "lines": [
                "月の民も兎も、月の裏でひっそりと",
                "暮らしているよ。"
            ]
        },
        "137_0": {
            "lines": [
                "結界を張ってひっそりと……。",
                "そう、幻想郷の様にね。"
            ]
        },
        "138_0": {
            "lines": [
                "月の幻想郷？"
            ]
        },
        "139_0": {
            "lines": [
                "そしてこの幻影の月は、月の記憶。"
            ]
        },
        "140_0": {
            "lines": [
                "古臭く見えるのはその為よ。"
            ]
        },
        "141_0": {
            "lines": [
                "で、そんな黴臭い月を持ち出して",
                "何をしようとしてたの？"
            ]
        },
        "142_0": {
            "lines": [
                "用事ならもう済んでいるわ。"
            ]
        },
        "143_0": {
            "lines": [
                "満月は月と地上を結ぶ唯一の鍵。"
            ]
        },
        "144_0": {
            "lines": [
                "これさえ無くせば、追手も月から",
                "地上にやって来れない。"
            ]
        },
        "145_0": {
            "lines": [
                "今頃、偽の地上に辿りついている",
                "でしょう。そう、黴臭い地上に。"
            ]
        },
        "146_0": {
            "lines": [
                "あなたは、犯罪者なのね。"
            ]
        },
        "147_0": {
            "lines": [
                "何かから逃げる者は罪を犯した者。"
            ]
        },
        "148_0": {
            "lines": [
                "身を隠そうとする者は罪を認めた者。"
            ]
        },
        "149_0": {
            "lines": [
                "そして、罪を認めた犯罪者は",
                "言い訳を始めるわ。"
            ]
        },
        "150_0": {
            "lines": [
                "……。"
            ]
        },
        "151_0": {
            "lines": [
                "いや別に。"
            ]
        },
        "152_0": {
            "lines": [
                "あんまりにもここが居心地が良かったから、",
                "月に帰りたくなかっただけよ。"
            ]
        },
        "153_0": {
            "lines": [
                "安心していいわ。",
                "朝になれば満月は元に戻してあげるから。"
            ]
        },
        "154_0": {
            "lines": [
                "幽々子さま、私に何かご指示を。"
            ]
        },
        "155_0": {
            "lines": [
                "あら、今頃になって私の言ってたことが",
                "判ってきたのかしら。"
            ]
        },
        "156_0": {
            "lines": [
                "じゃあ、まずは私の盾になりなさい。"
            ]
        },
        "157_0": {
            "lines": [
                "お任せください。",
                "冥界一硬い盾、ごらんに入れましょう。"
            ]
        },
        "158_0": {
            "lines": [
                "気が向いたら援護してあげるから。"
            ]
        },
        "159_0": {
            "lines": [
                "あはははは。"
            ]
        },
        "160_0": {
            "lines": [
                "盾は外からの力を防ぐ力しか持たない。"
            ]
        },
        "161_0": {
            "lines": [
                "我ら月の民は内なる力に作用させる",
                "能力を持つの。"
            ]
        },
        "162_0": {
            "lines": [
                "あなたが硬い盾になっている内に、中の",
                "やわらかい部分から腐っていく……。"
            ]
        },
        "163_0": {
            "lines": [
                "そう、そっちの能天気なお嬢さんからね。",
                "硬い盾なんて無意味だわ。"
            ]
        },
        "164_0": {
            "lines": [
                "妖夢、安心して。",
                "ナマ物じゃないから腐らないわ。"
            ]
        },
        "165_0": {
            "lines": [
                "判ってますよ。",
                "最初から腐っていることぐらい。"
            ]
        },
        "166_0": {
            "lines": [
                "でも、腐っていてもお守りするのが",
                "魂魄家の役割なんですよ。"
            ]
        },
        "167_0": {
            "lines": [
                "腐らないってば。"
            ]
        },
        "168_0": {
            "lines": [
                "いつまでその余裕が持つかしらね。"
            ]
        },
        "169_0": {
            "lines": [
                "留処なく溢れる月の記憶。"
            ]
        },
        "170_0": {
            "lines": [
                "これを浴びた地上人で狂わなかった",
                "人は居ない。"
            ]
        },
        "171_0": {
            "lines": [
                "仕様が無いわね。妖夢、狂わないように",
                "これだけは覚えておくのよ。"
            ]
        },
        "172_0": {
            "lines": [
                "ああ、人じゃなくて幽霊ね。",
                "それじゃ腐らないか。"
            ]
        },
        "173_0": {
            "lines": [
                "腐りかけが一番美味しいの。"
            ]
        },
        "174_0": {
            "lines": [
                "今それを教えられても……。"
            ]
        },
        "175_0": {
            "lines": [
                "言うわね。",
                "でも、発酵の能力は神の力。"
            ]
        },
        "176_0": {
            "lines": [
                "貴方達亡霊は神も見捨てたって事よ！"
            ]
        }
    },
    "3": {
        "60_0": {
            "lines": [
                "何遊んでるのよ！"
            ]
        },
        "61_0": {
            "lines": [
                "永琳、私の力でもう一度だけチャンスをあげる。"
            ]
        },
        "62_0": {
            "lines": [
                "これで負けたらその時は……。"
            ]
        },
        "63_0": {
            "lines": [
                "そこの亡霊！"
            ]
        },
        "64_0": {
            "lines": [
                "私の力で作られた薬と永琳の本当の力、",
                "一生忘れないものになるよ！"
            ]
        }
    }
}