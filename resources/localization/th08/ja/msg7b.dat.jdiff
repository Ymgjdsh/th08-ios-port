{
    "2": {
        "60_0": {
            "lines": [
                "ああもう。"
            ]
        },
        "61_0": {
            "lines": [
                "こっちに来させちゃ駄目だって言ってるのに。"
            ]
        },
        "62_0": {
            "lines": [
                "なんだか知らんが"
            ]
        },
        "63_0": {
            "lines": [
                "良い方に向かっている感じね。"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "満月だな。"
            ]
        },
        "121_0": {
            "lines": [
                "そう、ただの満月よ。"
            ]
        },
        "122_0": {
            "lines": [
                "貴方達が何百年も何千年も見てきた",
                "本物の魔力。"
            ]
        },
        "123_0": {
            "lines": [
                "魔理沙、あの満月は危ないわ。"
            ]
        },
        "124_0": {
            "lines": [
                "満月が危ない？",
                "なに寝ぼけた事言ってるんだ？"
            ]
        },
        "125_0": {
            "lines": [
                "あなたには見えないかも知れないけど……"
            ]
        },
        "126_0": {
            "lines": [
                "いま、大量に満月光線が降り注いでいるわ。"
            ]
        },
        "127_0": {
            "lines": [
                "変な名前をつけないの！"
            ]
        },
        "128_0": {
            "lines": [
                "今は、月本来の力が甦っているの。"
            ]
        },
        "129_0": {
            "lines": [
                "穢れのない月は、穢れのない地上を妖しく",
                "照らす。"
            ]
        },
        "130_0": {
            "lines": [
                "この光は貴き月の民ですら忘れた",
                "太古の記憶なのよ。"
            ]
        },
        "131_0": {
            "lines": [
                "つまり満月光線だな。",
                "見えないがびしびしと感じるぜ。"
            ]
        },
        "132_0": {
            "lines": [
                "これじゃぁ、普通の人間は５分と持たず",
                "発狂するわ。"
            ]
        },
        "133_0": {
            "lines": [
                "魔理沙は大丈夫かしら？"
            ]
        },
        "134_0": {
            "lines": [
                "ああ、狂うのには慣れているぜ。"
            ]
        },
        "135_0": {
            "lines": [
                "でも、これはどういうことなんだ？"
            ]
        },
        "136_0": {
            "lines": [
                "なんで今、満月なんだ。"
            ]
        },
        "137_0": {
            "lines": [
                "永琳の術で穢れのない月と穢れのない地上は",
                "隔離された。"
            ]
        },
        "138_0": {
            "lines": [
                "私はここにいる事で、地上からも月からも",
                "身を隠す事が出来る様になったわ。"
            ]
        },
        "139_0": {
            "lines": [
                "大げさなかくれんぼだな。"
            ]
        },
        "140_0": {
            "lines": [
                "でもね。"
            ]
        },
        "141_0": {
            "lines": [
                "永琳のこの術は完全だけど、あまり",
                "好きじゃないわ。"
            ]
        },
        "142_0": {
            "lines": [
                "ここには誰も居ない。",
                "誰も訪れない。"
            ]
        },
        "143_0": {
            "lines": [
                "退屈過ぎて死にそうだわ。"
            ]
        },
        "144_0": {
            "lines": [
                "穢れのない地上には誰もいない。"
            ]
        },
        "145_0": {
            "lines": [
                "月人らしいものの見方ね。"
            ]
        },
        "146_0": {
            "lines": [
                "丁度良いじゃないか。"
            ]
        },
        "147_0": {
            "lines": [
                "穢い私達がたっぷり遊んで、それから",
                "連れ出してやるよ。"
            ]
        },
        "148_0": {
            "lines": [
                "まぁ、私はここの生まれじゃないから、"
            ]
        },
        "149_0": {
            "lines": [
                "私を連れ出すのは本当に大変な事よ。"
            ]
        },
        "150_0": {
            "lines": [
                "……大昔にも同じ様なやり取りをした",
                "事があるわ。"
            ]
        },
        "151_0": {
            "lines": [
                "まぁ、私は満月なんてどうでもいいんだがな。"
            ]
        },
        "152_0": {
            "lines": [
                "こいつが満月が無いと困るって駄々を",
                "こねるんでねぇ。"
            ]
        },
        "153_0": {
            "lines": [
                "駄々をこねるどころじゃないわ。"
            ]
        },
        "154_0": {
            "lines": [
                "余りふざけたまねをしてると、天罰が",
                "下るわよ。"
            ]
        },
        "155_0": {
            "lines": [
                "天罰は怖いわね。"
            ]
        },
        "156_0": {
            "lines": [
                "でも、私が地上にいるのも天罰なの。"
            ]
        },
        "157_0": {
            "lines": [
                "そうだ、こんな私を連れ出そうとする",
                "人にはいつも難題を与えてきたわ。"
            ]
        },
        "158_0": {
            "lines": [
                "難題？"
            ]
        },
        "159_0": {
            "lines": [
                "それを解けばお前を連れ出せると",
                "いうのか？"
            ]
        },
        "160_0": {
            "lines": [
                "今まで、何人もの人間が敗れ去って",
                "いった五つの問題。"
            ]
        },
        "161_0": {
            "lines": [
                "貴方達に幾つ解けるかしら？"
            ]
        }
    },
    "3": {
        "60_0": {
            "lines": [
                "なんて事！"
            ]
        },
        "61_0": {
            "lines": [
                "そう、夜を止めていたのは……、"
            ]
        },
        "62_0": {
            "lines": [
                "貴方達だったのね。"
            ]
        }
    },
    "6": {
        "60_0": {
            "lines": [
                "貴方達が作った半端な永遠の夜なんて……"
            ]
        }
    },
    "7": {
        "60_0": {
            "lines": [
                "私の永遠を操る術で全て破って見せる。"
            ]
        }
    },
    "8": {
        "60_0": {
            "lines": [
                "夜明けはすぐそこにあるはずよ。"
            ]
        }
    },
    "9": {
        "60_0": {
            "lines": [
                "どう？",
                "これで永夜の術は破れて、夜は明ける！"
            ]
        }
    }
}