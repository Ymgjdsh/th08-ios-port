{
    "0": {
        "60_0": {
            "lines": [
                "遅かったわね。"
            ]
        },
        "121_0": {
            "lines": [
                "全ての扉は封印したわ。",
                "もう、姫は連れ出せないでしょう？"
            ]
        },
        "121_1": {
            "lines": [
                "貴方の仕業かしら？",
                "この月の異変は。"
            ]
        },
        "122_0": {
            "lines": [
                "怪しい感じね。",
                "特にその挑戦的な見た目とか。"
            ]
        },
        "123_0": {
            "lines": [
                "あら、羽付きのあなた程ではないわ。"
            ]
        },
        "124_0": {
            "lines": [
                "ところで、こんな夜中に何の用？"
            ]
        },
        "125_0": {
            "lines": [
                "それはもう凄い用よ。",
                "この月の異変は、貴方近辺の仕業でしょう？"
            ]
        },
        "126_0": {
            "lines": [
                "嫌な臭いは元から断て、ってね。"
            ]
        },
        "127_0": {
            "lines": [
                "私は掃除が得意なのよ。"
            ]
        },
        "128_0": {
            "lines": [
                "月の異変？",
                "うーん、この術によく気が付いたわね。"
            ]
        },
        "129_0": {
            "lines": [
                "地上に這いつくばって生きるだけの、",
                "穢き民のくせにね。"
            ]
        },
        "130_0": {
            "lines": [
                "あいにく、空に月と星しか見たことが無い",
                "汚れた生き物なんでねぇ。"
            ]
        },
        "131_0": {
            "lines": [
                "月に変化があれば嫌でもわかる。"
            ]
        },
        "132_0": {
            "lines": [
                "お嬢様は夜型、ですものねぇ。"
            ]
        },
        "133_0": {
            "lines": [
                "さっさと地上に満月を戻すのよ。"
            ]
        },
        "134_0": {
            "lines": [
                "まだ、術を解くわけに行かないの。"
            ]
        },
        "194_0": {
            "lines": [
                "あら、お迎えかと思ったら、"
            ]
        },
        "195_0": {
            "lines": [
                "ただの迷い妖怪？"
            ]
        },
        "196_0": {
            "lines": [
                "まぁ、お迎えが来れる筈が無いけど。"
            ]
        },
        "197_0": {
            "lines": [
                "誰？"
            ]
        },
        "198_0": {
            "lines": [
                "咲夜、悪いのはこいつよ。",
                "一発で判ったわ。この悪党面で。"
            ]
        },
        "199_0": {
            "lines": [
                "酷い言われ様だわ。"
            ]
        },
        "200_0": {
            "lines": [
                "確かに、この地上の密室は私が作ったわ。"
            ]
        },
        "201_0": {
            "lines": [
                "でも、これも姫とこの娘の為。"
            ]
        },
        "202_0": {
            "lines": [
                "そうと決まれば、倒さないわけには",
                "行かないですわ。"
            ]
        },
        "203_0": {
            "lines": [
                "うーん、でもまだ駄目。",
                "ウドンゲ、ここはお前に任せたわ。"
            ]
        },
        "204_0": {
            "lines": [
                "間違っても姫を連れ出されないようにね。"
            ]
        },
        "265_0": {
            "lines": [
                "お任せください。",
                "閉ざされた扉は一つも空かせません。"
            ]
        },
        "266_0": {
            "lines": [
                "何事にも順路という物があるって訳ね。"
            ]
        },
        "267_0": {
            "lines": [
                "面倒ね。いつもの咲夜みたいに、",
                "道を外れて見ない？"
            ]
        },
        "268_0": {
            "lines": [
                "順路通りに進んで、尚且つ力で圧倒する。",
                "これが文句を言わせないコツですわ。"
            ]
        },
        "269_0": {
            "lines": [
                "ふふふ。",
                "順路は貴方の後ろ方向。"
            ]
        },
        "270_0": {
            "lines": [
                "でも、引き返すのも出来ない。"
            ]
        },
        "271_0": {
            "lines": [
                "引き返さないわよ。"
            ]
        },
        "272_0": {
            "lines": [
                "月の兎の罠に嵌っているのに気が",
                "付いていないのかしら？"
            ]
        },
        "273_0": {
            "lines": [
                "そう、右も左も、上も下も……。",
                "貴方はもう方向が狂って見えている。"
            ]
        },
        "274_0": {
            "lines": [
                "貴方は、真っ直ぐに飛んでいるつもりでも、",
                "フラフラに飛んでいる。"
            ]
        },
        "275_0": {
            "lines": [
                "私の目を見て、もっと狂うが良いわ！"
            ]
        }
    },
    "3": {
        "180_0": {
            "lines": [
                "まっすぐ進む（FinalA）",
                "まっすぐ進まない（FinalB）"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "お嬢様、順路通り進みましょう。",
                "出口はもうすぐですよ。"
            ]
        },
        "61_0": {
            "lines": [
                "咲夜、さっきの奴はこの先に居る。",
                "でも、ちょっと……。"
            ]
        },
        "62_0": {
            "lines": [
                "気をつけた方が良いわね。",
                "咲夜とだから大丈夫だと思うけど。"
            ]
        },
        "63_0": {
            "lines": [
                "師匠は私なんか比べ物にならない程強いのよ。"
            ]
        },
        "64_0": {
            "lines": [
                "私に勝ったからって、師匠に敵うと",
                "思ってるの？"
            ]
        },
        "65_0": {
            "lines": [
                "圧倒的に。"
            ]
        },
        "66_0": {
            "lines": [
                "さぁ、夜が明ける前には決着を",
                "付けましょう。"
            ]
        },
        "67_0": {
            "lines": [
                "そうか、夜を延ばしていたのはあなた達",
                "だったのね。"
            ]
        },
        "68_0": {
            "lines": [
                "私はてっきり……。"
            ]
        },
        "69_0": {
            "lines": [
                "？"
            ]
        }
    },
    "2": {
        "60_0": {
            "lines": [
                "お嬢様、順路通り進みましょう。",
                "出口はもうすぐですよ。"
            ]
        },
        "61_0": {
            "lines": [
                "咲夜、さっきの奴はこの先に居る。",
                "でも、その前に。"
            ]
        },
        "62_0": {
            "lines": [
                "あそこに見える扉に入るのよ。"
            ]
        },
        "63_0": {
            "lines": [
                "何かあるんですか？"
            ]
        },
        "64_0": {
            "lines": [
                "ああ、しまった。",
                "まだ封印が間に合ってない扉があったのか。"
            ]
        },
        "65_0": {
            "lines": [
                "あそこの先に本命が居るわ。"
            ]
        },
        "66_0": {
            "lines": [
                "私の目はごまかせないわ。"
            ]
        },
        "67_0": {
            "lines": [
                "ああ、師匠に怒られるぅ。"
            ]
        }
    }
}