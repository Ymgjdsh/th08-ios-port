{
    "2": {
        "60_0": {
            "lines": [
                "ああもう。"
            ]
        },
        "61_0": {
            "lines": [
                "こっちに来させちゃ駄目だって言ってるのに。"
            ]
        },
        "62_0": {
            "lines": [
                "霊夢。",
                "こいつの言っている意味、わかる？"
            ]
        },
        "63_0": {
            "lines": [
                "ええ、こっちが正解って事でしょ？"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "久々の満月が……。"
            ]
        },
        "121_0": {
            "lines": [
                "そう、地上から見た本物の満月よ。"
            ]
        },
        "122_0": {
            "lines": [
                "それにしても人間と妖怪……。",
                "今日は珍しい客が来ているわね。"
            ]
        },
        "123_0": {
            "lines": [
                "あんたは……。",
                "一体何者よ。"
            ]
        },
        "124_h1_0": {
            "lines": [
                "輝夜"
            ]
        },
        "124_0": {
            "lines": [
                "私は輝夜。"
            ]
        },
        "125_0": {
            "lines": [
                "でも、あなたが先に名乗ってないのに、",
                "質問してきた事には怒らない。"
            ]
        },
        "126_0": {
            "lines": [
                "その程度で恩を着せようなんてのは甘いわ。"
            ]
        },
        "127_0": {
            "lines": [
                "誰もそんな事言っていない。"
            ]
        },
        "128_0": {
            "lines": [
                "最近、永琳が屋敷の外に出させて",
                "くれないのよ。"
            ]
        },
        "129_0": {
            "lines": [
                "だから、たまのお客様は大切に扱うわ。"
            ]
        },
        "130_0": {
            "lines": [
                "弾のお客様？"
            ]
        },
        "131_0": {
            "lines": [
                "弾幕馬鹿みたいな言い方しないの。"
            ]
        },
        "132_0": {
            "lines": [
                "人間に宿るは儚い霊（たま）。"
            ]
        },
        "133_0": {
            "lines": [
                "その人間が住むのは大きな球。"
            ]
        },
        "134_0": {
            "lines": [
                "そして、貴き民が住むのは……、"
            ]
        },
        "135_0": {
            "lines": [
                "後ろに見える狂おしい珠。"
            ]
        },
        "136_0": {
            "lines": [
                "で、私達が避けるのは、"
            ]
        },
        "137_0": {
            "lines": [
                "美しき弾、っと。"
            ]
        },
        "138_0": {
            "lines": [
                "人の台詞を取らないの。",
                "こっちの方は怒るわよ。"
            ]
        },
        "139_0": {
            "lines": [
                "ほら、先が読める台詞は、言わなく",
                "ても伝わるからいいの。"
            ]
        },
        "140_0": {
            "lines": [
                "何せ、私達は弾のお客様だもんねぇ。"
            ]
        },
        "141_0": {
            "lines": [
                "全くもう、せっかちねぇ。"
            ]
        },
        "142_0": {
            "lines": [
                "焦らなくても見せてあげるわよ。"
            ]
        },
        "143_0": {
            "lines": [
                "本当の月が持つ毒気を！",
                "それと、私からの美しき難題を！"
            ]
        },
        "144_0": {
            "lines": [
                "本当に暇そうね……。",
                "待ち構えて遊び相手を探していたの？"
            ]
        },
        "145_0": {
            "lines": [
                "って、折角決まった所で水をさす～。"
            ]
        },
        "146_0": {
            "lines": [
                "今まで身を隠していたから余り外に",
                "出れなかっただけよ。"
            ]
        },
        "147_0": {
            "lines": [
                "でも、今日はその分遊ばさせてもらう。"
            ]
        },
        "148_0": {
            "lines": [
                "まぁいいけどね。",
                "もう満月は元に戻った見たいだし。"
            ]
        },
        "149_0": {
            "lines": [
                "後はけじめとして、犯人を懲らしめれば",
                "いいだけよ。"
            ]
        },
        "150_0": {
            "lines": [
                "あいにく、本物の満月はここでしか",
                "見えないよ。"
            ]
        },
        "151_0": {
            "lines": [
                "なんだってー！"
            ]
        },
        "152_0": {
            "lines": [
                "って言うほどでもないけど。",
                "どうせ懲らしめるし。"
            ]
        },
        "153_0": {
            "lines": [
                "さぁそろそろ、心の準備は出来たかしら。"
            ]
        },
        "154_0": {
            "lines": [
                "出来てない。"
            ]
        },
        "155_0": {
            "lines": [
                "出来てない。"
            ]
        },
        "156_0": {
            "lines": [
                "今まで、何人もの人間が敗れ去って",
                "いった五つの問題。"
            ]
        },
        "157_0": {
            "lines": [
                "貴方達に幾つ解けるかしら？"
            ]
        }
    },
    "3": {
        "60_0": {
            "lines": [
                "なんて事！"
            ]
        },
        "61_0": {
            "lines": [
                "そう、夜を止めていたのは……、"
            ]
        },
        "62_0": {
            "lines": [
                "貴方達だったのね。"
            ]
        }
    },
    "6": {
        "60_0": {
            "lines": [
                "貴方達が作った半端な永遠の夜なんて……"
            ]
        }
    },
    "7": {
        "60_0": {
            "lines": [
                "私の永遠を操る術で全て破って見せる。"
            ]
        }
    },
    "8": {
        "60_0": {
            "lines": [
                "夜明けはすぐそこにあるはずよ。"
            ]
        }
    },
    "9": {
        "60_0": {
            "lines": [
                "どう？",
                "これで永夜の術は破れて、夜は明ける！"
            ]
        }
    }
}