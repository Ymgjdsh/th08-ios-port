{
    "0": {
        "60_0": {
            "lines": [
                "遅かったわね。"
            ]
        },
        "121_0": {
            "lines": [
                "全ての扉は封印したわ。",
                "もう、姫は連れ出せないでしょう？"
            ]
        },
        "121_1": {
            "lines": [
                "犯人はこいつかしら？"
            ]
        },
        "122_0": {
            "lines": [
                "さぁねぇ。取り敢えず倒してみたら？",
                "ここに居るはずだし。"
            ]
        },
        "123_h1_0": {
            "lines": [
                "鈴仙"
            ]
        },
        "123_0": {
            "lines": [
                "何だ、妖怪か。"
            ]
        },
        "124_0": {
            "lines": [
                "そうよね、ここまで来れるはずが無いし。",
                "心配して損したわ。"
            ]
        },
        "125_0": {
            "lines": [
                "私はまだ人間よ。"
            ]
        },
        "126_0": {
            "lines": [
                "人間ならなおさらだわ。"
            ]
        },
        "127_0": {
            "lines": [
                "一体、何を心配していたのかしら？",
                "こんな悪さしておいて。"
            ]
        },
        "128_0": {
            "lines": [
                "悪さ？",
                "んー、地上の密室のこと？"
            ]
        },
        "129_0": {
            "lines": [
                "なの？",
                "よく分からないけど。"
            ]
        },
        "130_0": {
            "lines": [
                "満月の事よ。",
                "よく分からないけど。"
            ]
        },
        "131_0": {
            "lines": [
                "ああ月の事？　それはね、私の師匠、",
                "永琳の取っておきの秘術。"
            ]
        },
        "132_0": {
            "lines": [
                "この地上を密室化する秘術なの。",
                "判るかしら？"
            ]
        },
        "133_0": {
            "lines": [
                "判る訳が無いわ。"
            ]
        },
        "193_0": {
            "lines": [
                "ううん。",
                "そんなんじゃ人間には判らないわ。"
            ]
        },
        "194_0": {
            "lines": [
                "それに、満月を無くす程度の術。",
                "取っておきでも何でもない。"
            ]
        },
        "195_0": {
            "lines": [
                "霊夢。",
                "こいつが犯人よ。匂いがする。"
            ]
        },
        "196_0": {
            "lines": [
                "そう？",
                "私の勘はなんだか……。"
            ]
        },
        "197_0": {
            "lines": [
                "さぁ、この歪な月を元に戻して",
                "もらいましょうか！"
            ]
        },
        "198_0": {
            "lines": [
                "……それは、まだ早いわ。",
                "今、この術を解く訳にはいかないの。"
            ]
        },
        "199_0": {
            "lines": [
                "ウドンゲ。",
                "荒事と狂気は全てお前の仕事でしょ？"
            ]
        },
        "200_0": {
            "lines": [
                "ここは任せたわ。"
            ]
        },
        "261_0": {
            "lines": [
                "お任せください。",
                "閉ざされた扉は一つも空かせません。"
            ]
        },
        "262_0": {
            "lines": [
                "逃げたって一緒よ。どうせ、こいつを",
                "倒して追う事になるんだから。"
            ]
        },
        "263_0": {
            "lines": [
                "そうねぇ。それにこいつ倒しても",
                "満月は戻らなさそうねぇ。"
            ]
        },
        "264_0": {
            "lines": [
                "ふん。最近、戦える相手が",
                "居なかったから丁度いいわ。"
            ]
        },
        "265_0": {
            "lines": [
                "あなた達に全て見せてあげるわ。",
                "月の狂気を！"
            ]
        },
        "266_0": {
            "lines": [
                "月の狂気？"
            ]
        },
        "267_0": {
            "lines": [
                "月に来た人間を狂わせた催眠術。",
                "あの人間は弱かったわ。"
            ]
        },
        "268_0": {
            "lines": [
                "こいつ。危なそうね。"
            ]
        },
        "269_0": {
            "lines": [
                "月は人を狂わすの。"
            ]
        },
        "270_0": {
            "lines": [
                "そう、月の兎である私の目を見て",
                "狂わずに居られるかしら？"
            ]
        }
    },
    "3": {
        "180_0": {
            "lines": [
                "目に見えるものを追う（FinalA）",
                "勘を信じる（FinalB）"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "さぁ、さっきのを追うわよ。"
            ]
        },
        "61_0": {
            "lines": [
                "さっきのは何処に入っていったのかしら？",
                "扉が多すぎて判らないわ。"
            ]
        },
        "62_0": {
            "lines": [
                "さっきの、……って、師匠をさっきの",
                "呼ばわりしないで。"
            ]
        },
        "63_0": {
            "lines": [
                "犯人はこの奥に居るわ。"
            ]
        },
        "64_0": {
            "lines": [
                "犯人が自殺する前に捕まえるのよ。"
            ]
        },
        "65_0": {
            "lines": [
                "自殺しないし、犯人って……。"
            ]
        },
        "66_0": {
            "lines": [
                "うるさい白兎。",
                "その辺で皮引ん剥くわよ。"
            ]
        }
    },
    "2": {
        "60_0": {
            "lines": [
                "さぁ、さっきのを追うわよ。"
            ]
        },
        "61_0": {
            "lines": [
                "さっきのは何処に入っていったのかしら？",
                "扉が多すぎて判らないわ。"
            ]
        },
        "62_0": {
            "lines": [
                "紫。",
                "ほら、あそこの扉……。"
            ]
        },
        "63_0": {
            "lines": [
                "ああまずい！",
                "封印が間に合わなかったわ。"
            ]
        },
        "64_0": {
            "lines": [
                "犯人はそこかしら？"
            ]
        },
        "65_0": {
            "lines": [
                "私の勘がそこだって言ってるわ。",
                "いくわよ。"
            ]
        },
        "66_0": {
            "lines": [
                "ああ、師匠にしかられるぅ。"
            ]
        }
    }
}