{
    "2": {
        "60_0": {
            "lines": [
                "ああもう。"
            ]
        },
        "61_0": {
            "lines": [
                "こっちに来させちゃ駄目だって言ってるのに。"
            ]
        },
        "62_0": {
            "lines": [
                "咲夜。",
                "こいつはフェイクよ。"
            ]
        },
        "63_0": {
            "lines": [
                "では、速攻で倒させて頂きますわ。"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "お嬢様。",
                "お怪我はないですか？"
            ]
        },
        "121_0": {
            "lines": [
                "有るわ。"
            ]
        },
        "122_0": {
            "lines": [
                "無いよ。"
            ]
        },
        "123_0": {
            "lines": [
                "って、あんた誰？"
            ]
        },
        "124_0": {
            "lines": [
                "鈴仙と永琳を倒してここまで来るなんて……。"
            ]
        },
        "125_0": {
            "lines": [
                "怪我の一つでも負って貰わないと、割に",
                "合わないわ。"
            ]
        },
        "126_0": {
            "lines": [
                "あいにく、満月の夜は無敵なんでねぇ。"
            ]
        },
        "127_0": {
            "lines": [
                "初めて聞きましたわ。そんな事。"
            ]
        },
        "128_0": {
            "lines": [
                "……っていつの間にか満月ですわ。",
                "お嬢様。"
            ]
        },
        "129_0": {
            "lines": [
                "判ってるから言ったんだけどね。"
            ]
        },
        "130_0": {
            "lines": [
                "これが真実の満月よ。"
            ]
        },
        "131_0": {
            "lines": [
                "いつ頃だったかしら、この満月が地上から",
                "消えたのは。"
            ]
        },
        "132_0": {
            "lines": [
                "満月から人を狂わす力が失われたのは。"
            ]
        },
        "133_0": {
            "lines": [
                "この満月は……。"
            ]
        },
        "134_0": {
            "lines": [
                "咲夜が危ない！"
            ]
        },
        "135_0": {
            "lines": [
                "そう、直に見た人間を狂わす真実の満月。"
            ]
        },
        "136_0": {
            "lines": [
                "いや別に何にも有りませんが？"
            ]
        },
        "137_0": {
            "lines": [
                "……咲夜は危なくなかったわね。",
                "鍛えてあるし。"
            ]
        },
        "138_0": {
            "lines": [
                "まぁ、咲夜がいなくてもこの満月下なら",
                "無敵だけど。"
            ]
        },
        "139_0": {
            "lines": [
                "あら、それは酷いじゃないですか。"
            ]
        },
        "140_0": {
            "lines": [
                "どんな場面でも、私は力になりますよ。",
                "頼りにしてください。"
            ]
        },
        "141_0": {
            "lines": [
                "あら、咲夜、ちょっと狂い始めてない？"
            ]
        },
        "142_0": {
            "lines": [
                "月は地上に様々な力を与えた。"
            ]
        },
        "143_0": {
            "lines": [
                "魔法の様な力の殆どが、元々は月の力。"
            ]
        },
        "144_0": {
            "lines": [
                "貴方のお仲間にも満月頼りの者も居るん",
                "じゃない？そこな吸血鬼さん。"
            ]
        },
        "145_0": {
            "lines": [
                "だから何よ。"
            ]
        },
        "146_0": {
            "lines": [
                "満月となった今。",
                "無敵ってことですよ。素敵。"
            ]
        },
        "147_0": {
            "lines": [
                "ふふ。"
            ]
        },
        "148_0": {
            "lines": [
                "我々月の民は、地上人を魔物に変えて、",
                "地上人の穢れを調節してきた。"
            ]
        },
        "149_0": {
            "lines": [
                "でも、もうそれもお終い。"
            ]
        },
        "150_0": {
            "lines": [
                "地上人は自ら魔物を封印してしまった。"
            ]
        },
        "151_0": {
            "lines": [
                "今の魔物は、ただのお約束として人を襲うだけ",
                "の良く判らない生き物になってしまったわ。"
            ]
        },
        "152_0": {
            "lines": [
                "今の紅茶を飲む毎日の方が楽しいんだよ。",
                "それが何が悪い。"
            ]
        },
        "153_0": {
            "lines": [
                "……。"
            ]
        },
        "154_0": {
            "lines": [
                "地上人は次第に月を、夜を恐れなくなった。"
            ]
        },
        "155_0": {
            "lines": [
                "地上人は益々増長したわ。"
            ]
        },
        "156_0": {
            "lines": [
                "月の光が必要で無くなった夜。"
            ]
        },
        "157_0": {
            "lines": [
                "潮の満ち干が無関係な海岸。"
            ]
        },
        "158_0": {
            "lines": [
                "終いには月にまで攻め込んだって言う",
                "じゃない。"
            ]
        },
        "159_0": {
            "lines": [
                "ふん、そんな下賎な人間の事なんて",
                "知らんな。"
            ]
        },
        "160_0": {
            "lines": [
                "大体、あんた、月の民なんだろう？"
            ]
        },
        "161_0": {
            "lines": [
                "月に帰って地上人と戦えばいいじゃないか。"
            ]
        },
        "162_0": {
            "lines": [
                "私は……。"
            ]
        },
        "163_0": {
            "lines": [
                "月には帰れない理由があるの。"
            ]
        },
        "164_0": {
            "lines": [
                "それに、月の民の味方でもないわ。",
                "地上でもおおっぴらには動けないけど。"
            ]
        },
        "165_0": {
            "lines": [
                "月には帰れない、地上でも居場所がない。"
            ]
        },
        "166_0": {
            "lines": [
                "よっぽど悪い事したんでしょうね。"
            ]
        },
        "167_0": {
            "lines": [
                "地上人にも迷惑をかけない様に、力のない者",
                "には会わない様にしていたのよ。"
            ]
        },
        "168_0": {
            "lines": [
                "無敵のお嬢様と無敵の人間。"
            ]
        },
        "169_0": {
            "lines": [
                "私たちに力がないのか試す？"
            ]
        },
        "170_0": {
            "lines": [
                "今まで、何人もの地上人が敗れ去って",
                "いった五つの問題。"
            ]
        },
        "171_0": {
            "lines": [
                "この難題をクリア出来るのかしら？"
            ]
        }
    },
    "3": {
        "60_0": {
            "lines": [
                "なんて事！"
            ]
        },
        "61_0": {
            "lines": [
                "そう、夜を止めていたのは……、"
            ]
        },
        "62_0": {
            "lines": [
                "貴方達だったのね。"
            ]
        }
    },
    "6": {
        "60_0": {
            "lines": [
                "貴方達が作った半端な永遠の夜なんて……"
            ]
        }
    },
    "7": {
        "60_0": {
            "lines": [
                "私の永遠を操る術で全て破って見せる。"
            ]
        }
    },
    "8": {
        "60_0": {
            "lines": [
                "夜明けはすぐそこにあるはずよ。"
            ]
        }
    },
    "9": {
        "60_0": {
            "lines": [
                "どう？",
                "これで永夜の術は破れて、夜は明ける！"
            ]
        }
    }
}