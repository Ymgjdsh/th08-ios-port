{
    "2": {
        "60_0": {
            "lines": [
                "ふふふ。"
            ]
        },
        "61_0": {
            "lines": [
                "無事ついて来てるようね。"
            ]
        },
        "62_0": {
            "lines": [
                "この廊下はおかしいわ。",
                "いくらなんでもこんなに長い筈がない。"
            ]
        },
        "63_0": {
            "lines": [
                "外も見たことが無い世界になってる！"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "長い廊下ももう終った見たいね",
                "そろそろ観念したらどう？"
            ]
        },
        "121_0": {
            "lines": [
                "あはははは。",
                "貴方達は愚かねぇ。"
            ]
        },
        "122_0": {
            "lines": [
                "ほら、馬鹿だって。",
                "神社で巫女なんかやってるから。"
            ]
        },
        "123_h1_0": {
            "lines": [
                "永琳"
            ]
        },
        "123_0": {
            "lines": [
                "もうすぐ朝になる。"
            ]
        },
        "124_0": {
            "lines": [
                "そうなれば、もう満月は返すわ。"
            ]
        },
        "125_0": {
            "lines": [
                "あら、聞き分けいいじゃない。"
            ]
        },
        "126_0": {
            "lines": [
                "もう術は完成しているの。"
            ]
        },
        "127_0": {
            "lines": [
                "何人たりとも姫を連れ出す事は出来ない。"
            ]
        },
        "128_0": {
            "lines": [
                "姫？",
                "姫なんて最初から興味は無いわ。"
            ]
        },
        "129_0": {
            "lines": [
                "私達は満月さえ戻ればそれでいいの。"
            ]
        },
        "130_0": {
            "lines": [
                "心配しなくても、朝が来れば",
                "元に戻すわよ。"
            ]
        },
        "131_0": {
            "lines": [
                "そうはいかない。"
            ]
        },
        "132_0": {
            "lines": [
                "私達は、朝が来る前に満月を",
                "取り戻しに来たんだから。"
            ]
        },
        "133_0": {
            "lines": [
                "せっかちねぇ。"
            ]
        },
        "134_0": {
            "lines": [
                "でも、私達が今居る場所。",
                "何処だか判るかしら？"
            ]
        },
        "135_0": {
            "lines": [
                "？？"
            ]
        },
        "136_0": {
            "lines": [
                "ここは偽の月と地上の間。"
            ]
        },
        "137_0": {
            "lines": [
                "さっきの永い廊下は、偽の月と地上を",
                "結ぶ偽物の通路。"
            ]
        },
        "138_0": {
            "lines": [
                "貴方達は偽満月が生み出した幻像に",
                "騙されてここまで来たのよ。"
            ]
        },
        "139_0": {
            "lines": [
                "で？",
                "だから何よ。"
            ]
        },
        "140_0": {
            "lines": [
                "貴方達には戻る術があるのかしら？"
            ]
        },
        "141_0": {
            "lines": [
                "そうねぇ。",
                "それは貴方を倒してから考える事。"
            ]
        },
        "142_0": {
            "lines": [
                "焦る事はないわ。"
            ]
        },
        "143_0": {
            "lines": [
                "まんまと私の術に嵌る奴が、どうして",
                "私に敵うと思うのか不思議だわ。"
            ]
        },
        "144_0": {
            "lines": [
                "まぁ、私も鬼じゃないし。"
            ]
        },
        "145_0": {
            "lines": [
                "まぁ、朝までなら遊んであげるわよ。"
            ]
        },
        "146_0": {
            "lines": [
                "よく分からないけど。"
            ]
        },
        "147_0": {
            "lines": [
                "こいつを倒せば万事解決？"
            ]
        },
        "148_0": {
            "lines": [
                "そんなだから馬鹿って言われるのよ。"
            ]
        },
        "149_0": {
            "lines": [
                "でも大正解。"
            ]
        },
        "150_0": {
            "lines": [
                "博麗霊夢の言う事は全て正解よ。"
            ]
        },
        "151_0": {
            "lines": [
                "今頃、地上人も月に辿りつけないで",
                "永遠に彷徨っていることでしょう。"
            ]
        },
        "152_0": {
            "lines": [
                "月の民も同じ。"
            ]
        },
        "153_0": {
            "lines": [
                "これで月の民も地上に来れないはず。"
            ]
        },
        "154_0": {
            "lines": [
                "これが私の最大の秘術の一つ。",
                "地上は大きな密室と化したのよ。"
            ]
        },
        "155_0": {
            "lines": [
                "さっきの兎といい。",
                "狂ってる奴が多すぎね。"
            ]
        },
        "156_0": {
            "lines": [
                "さぁ、紫。",
                "こんな奴さっさと倒して、地上に帰るわよ。"
            ]
        },
        "157_0": {
            "lines": [
                "あら、遊んでいく気になったみたいね。"
            ]
        },
        "158_0": {
            "lines": [
                "あいにく私は、永遠に遊ぶ力は持って",
                "いないけど……。"
            ]
        },
        "159_0": {
            "lines": [
                "それでも、朝まで遊ぶこと位は出来るわ。"
            ]
        },
        "160_0": {
            "lines": [
                "永遠に遊んでみたい物ね。",
                "でも、それはまたの機会にでも……。"
            ]
        },
        "161_0": {
            "lines": [
                "さぁ、幻想郷の世明けはもう目の前にある！"
            ]
        }
    },
    "3": {
        "60_0": {
            "lines": [
                "何遊んでるのよ！"
            ]
        },
        "61_0": {
            "lines": [
                "永琳、私の力でもう一度だけチャンスをあげる。"
            ]
        },
        "62_0": {
            "lines": [
                "これで負けたらその時は……。"
            ]
        },
        "63_0": {
            "lines": [
                "そこの人妖！"
            ]
        },
        "64_0": {
            "lines": [
                "私の力で作られた薬と永琳の本当の力、",
                "一生忘れないものになるよ！"
            ]
        }
    }
}