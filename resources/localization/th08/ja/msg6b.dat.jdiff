{
    "2": {
        "60_0": {
            "lines": [
                "ふふふ。"
            ]
        },
        "61_0": {
            "lines": [
                "無事ついて来てるようね。"
            ]
        },
        "62_0": {
            "lines": [
                "魔理沙！",
                "こいつを撃つのよ。"
            ]
        },
        "63_0": {
            "lines": [
                "んなもん、言われなくても判ってるぜ。"
            ]
        }
    },
    "0": {
        "60_0": {
            "lines": [
                "何度も出てきたり逃げたりしていたようだが、",
                "それは焦りか？"
            ]
        },
        "121_0": {
            "lines": [
                "焦り？",
                "貴方達は愚かねぇ。"
            ]
        },
        "122_0": {
            "lines": [
                "ここまで誘導されてきた事にも",
                "気が付かないのかしら。"
            ]
        },
        "123_0": {
            "lines": [
                "魔理沙、周りを見て！"
            ]
        },
        "124_0": {
            "lines": [
                "見てるって。",
                "何時の間にか外だな。"
            ]
        },
        "125_0": {
            "lines": [
                "そう、外よ。",
                "貴方達は永い廊下に導かれてここまで来た。"
            ]
        },
        "126_0": {
            "lines": [
                "どう？",
                "外の空気は。"
            ]
        },
        "127_0": {
            "lines": [
                "というか、空気はあるんだな。",
                "地上の外も。"
            ]
        },
        "128_0": {
            "lines": [
                "魔理沙！おかしいわよ。",
                "この月も星も……。"
            ]
        },
        "129_0": {
            "lines": [
                "さっきから、魔理沙魔理沙うるさいなぁ。",
                "結局人が居なきゃ何も出来ないのかよ。"
            ]
        },
        "130_0": {
            "lines": [
                "ふふふ。",
                "こうやって、月に向う人間を偽の月に繋ぐ。"
            ]
        },
        "131_0": {
            "lines": [
                "月と地上を結ぶ道は、私の手によって",
                "切られたわ。"
            ]
        },
        "132_0": {
            "lines": [
                "これで、地上人は月に辿り着けない。"
            ]
        },
        "133_0": {
            "lines": [
                "そして月の民は、姫を探し出せない。"
            ]
        },
        "134_0": {
            "lines": [
                "姫？",
                "そうか、お前達は月の民か。"
            ]
        },
        "135_0": {
            "lines": [
                "なんでそう思うの？"
            ]
        },
        "136_0": {
            "lines": [
                "狂ってる奴は大抵、月が原因だ。",
                "深い意味は無いぜ。"
            ]
        },
        "137_0": {
            "lines": [
                "そう、姫も私も鈴仙も月の生まれよ。"
            ]
        },
        "138_0": {
            "lines": [
                "でも、もう帰らない事にしたわ。",
                "ずっと昔にね。"
            ]
        },
        "139_0": {
            "lines": [
                "別にあんたらが帰ろうがどうだろうが",
                "関係無いがな。"
            ]
        },
        "140_0": {
            "lines": [
                "月の民は、月を見て楽しむ民の事を",
                "考えているのか？"
            ]
        },
        "141_0": {
            "lines": [
                "そんなもの……。"
            ]
        },
        "142_0": {
            "lines": [
                "地上人も見てるだけなら問題",
                "なかったのに……。"
            ]
        },
        "143_0": {
            "lines": [
                "わざわざ月にまで来ようとしたり、",
                "挙句の果てに、"
            ]
        },
        "144_0": {
            "lines": [
                "旗を立てて、自分の物だ、みたいに",
                "いう愚かな地上人が出てくる。"
            ]
        },
        "145_0": {
            "lines": [
                "そんなだから何時まで経っても、",
                "地上人は下賎なのよ。"
            ]
        },
        "146_0": {
            "lines": [
                "ふん。",
                "私達はそんな真似はしてないわ。"
            ]
        },
        "147_0": {
            "lines": [
                "地上に満月が無いと困る民も居る。"
            ]
        },
        "148_0": {
            "lines": [
                "そんな地上であなたが満月を隠せば、",
                "それなりの報復を受ける事も考えているの？"
            ]
        },
        "149_0": {
            "lines": [
                "ああ、いいのよ。",
                "術はもう済んだから。"
            ]
        },
        "150_0": {
            "lines": [
                "朝になれば満月は返してあげる。",
                "といっても、元々私達のものだけどね。"
            ]
        },
        "151_0": {
            "lines": [
                "そうかい。"
            ]
        },
        "152_0": {
            "lines": [
                "じゃぁ、残りは今まで隠していた分の",
                "報復だけ、という事だな。"
            ]
        },
        "153_0": {
            "lines": [
                "そうね。",
                "どの位痛みつければ良いのかしらね。"
            ]
        },
        "154_0": {
            "lines": [
                "あらあら、痛いのは嫌だわ。"
            ]
        },
        "155_0": {
            "lines": [
                "あいにく、私は薬学の心得があるから、",
                "多少の怪我なら大丈夫だけど。"
            ]
        },
        "156_0": {
            "lines": [
                "それは有難い事で。",
                "私達の滋養回復でもお願いするか。"
            ]
        },
        "157_0": {
            "lines": [
                "それにね、薬は攻撃にも使えるのよ！"
            ]
        }
    },
    "3": {
        "60_0": {
            "lines": [
                "何遊んでるのよ！"
            ]
        },
        "61_0": {
            "lines": [
                "永琳、私の力でもう一度だけチャンスをあげる。"
            ]
        },
        "62_0": {
            "lines": [
                "これで負けたらその時は……。"
            ]
        },
        "63_0": {
            "lines": [
                "そこの野良猫！"
            ]
        },
        "64_0": {
            "lines": [
                "私の力で作られた薬と永琳の本当の力、",
                "一生忘れないものになるよ！"
            ]
        }
    }
}