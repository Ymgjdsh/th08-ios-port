{
    "0": {
        "60_0": {
            "lines": [
                "動くと撃つ！"
            ]
        },
        "121_0": {
            "lines": [
                "間違えた。",
                "撃つと動くだ。私が動く。"
            ]
        },
        "121_1": {
            "lines": [
                "何？",
                "こんなところで遭うなんて珍しい。"
            ]
        },
        "122_0": {
            "lines": [
                "さぁな。私はいつも通り、迷惑な妖怪を退治",
                "しているだけだぜ。"
            ]
        },
        "123_0": {
            "lines": [
                "迷惑って、誰がこんなことしたか知ってるの？"
            ]
        },
        "124_0": {
            "lines": [
                "だからー、普通は判るわ。"
            ]
        },
        "125_0": {
            "lines": [
                "そりゃ判るぜ。",
                "こんな所に妖気集めた奴が飛んでいればな。"
            ]
        },
        "126_0": {
            "lines": [
                "明日は待ちにまったお月見の日だ。",
                "今日の月なんてもう見飽きたぜ。"
            ]
        },
        "127_0": {
            "lines": [
                "あら、判って無さそうね。"
            ]
        },
        "128_0": {
            "lines": [
                "夜を止めているのは私達。"
            ]
        },
        "129_0": {
            "lines": [
                "お前達だろ？"
            ]
        },
        "130_0": {
            "lines": [
                "だからやっつけに来たんじゃないか。"
            ]
        },
        "131_0": {
            "lines": [
                "そこの黒いの。",
                "後ろの歪な月を見て何も感じないのか？"
            ]
        },
        "132_0": {
            "lines": [
                "もう見飽きたって言っただろ？"
            ]
        },
        "133_0": {
            "lines": [
                "現実に目を背けるな。"
            ]
        },
        "134_0": {
            "lines": [
                "こうしている間にもあの歪な月は沈む。"
            ]
        },
        "135_0": {
            "lines": [
                "放っておけば大変な事になるのが",
                "判らんのか？"
            ]
        },
        "136_0": {
            "lines": [
                "あー？夜が終らない方が大変だぜ。"
            ]
        },
        "137_0": {
            "lines": [
                "竹だって、一日が終らなければ永遠に成長",
                "するかも知れない。"
            ]
        },
        "138_0": {
            "lines": [
                "それこそ月まで、でもな。"
            ]
        },
        "139_0": {
            "lines": [
                "出る杭は打たれるの。",
                "あれ？打つと動くんだったっけ？"
            ]
        },
        "140_0": {
            "lines": [
                "ああ、動くぜ。",
                "夜が明けるまで動いてやるぜ。"
            ]
        }
    },
    "2": {
        "60_0": {
            "lines": [
                "幽々子さま、逃げましたよ。",
                "追いますか？"
            ]
        },
        "61_0": {
            "lines": [
                "困ったわね。",
                "私達もあっちに向ってるんだけど……。"
            ]
        }
    },
    "3": {
        "60_0": {
            "lines": [
                "撃ったから動いた。",
                "さぁ、これからが本番だぜ。"
            ]
        },
        "61_0": {
            "lines": [
                "まだやるのか？",
                "もう勝負あっただろう？"
            ]
        },
        "62_0": {
            "lines": [
                "ふん。",
                "そっちが二人なら、こっちは二回だ！"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "とんだ無駄な時間を過ごしてしまった。"
            ]
        },
        "61_0": {
            "lines": [
                "幽霊に無駄な時間なんて無いの。",
                "全ては筋書き通り。"
            ]
        },
        "62_0": {
            "lines": [
                "くそ。",
                "一体、何だと言うんだ？"
            ]
        },
        "63_0": {
            "lines": [
                "一瞬も全て。全ても一瞬。",
                "あなたと遊んでいる時間も必然よ。"
            ]
        },
        "64_0": {
            "lines": [
                "あれ？",
                "竹林の奥に大きな屋敷が見えます。"
            ]
        },
        "65_0": {
            "lines": [
                "妖夢。",
                "判らない方がおかしいって言ってたでしょ？"
            ]
        },
        "66_0": {
            "lines": [
                "そこに居るわよ。",
                "探していた龍料理が。"
            ]
        }
    }
}