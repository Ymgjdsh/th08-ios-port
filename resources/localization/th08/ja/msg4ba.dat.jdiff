{
    "0": {
        "60_0": {
            "lines": [
                "動くと撃つ！"
            ]
        },
        "121_0": {
            "lines": [
                "間違えた。",
                "撃つと動くだ。今すぐ動く。"
            ]
        },
        "121_1": {
            "lines": [
                "何？",
                "何でこんな所に魔理沙がいるの？"
            ]
        },
        "122_h1_0": {
            "lines": [
                "魔理沙"
            ]
        },
        "122_0": {
            "lines": [
                "さぁな。私はいつも通り、迷惑な妖怪を退治",
                "しているだけだぜ。"
            ]
        },
        "123_0": {
            "lines": [
                "へぇ、奇遇ね。",
                "私も迷惑な妖怪退治をしているの。"
            ]
        },
        "124_0": {
            "lines": [
                "私が言ってるのは「迷惑な妖怪」を退治だ。",
                "お前の場合は、迷惑な「妖怪退治」だろ？"
            ]
        },
        "125_0": {
            "lines": [
                "そうでもないわ。"
            ]
        },
        "126_0": {
            "lines": [
                "へぇ、こんな夜に、あなた一人で何が出来る",
                "かしら。"
            ]
        },
        "127_0": {
            "lines": [
                "迷惑な妖怪退治だ。"
            ]
        },
        "128_0": {
            "lines": [
                "今日の月なんてもう見飽きた。",
                "そろそろ、明日にしてもらうぜ。"
            ]
        },
        "129_0": {
            "lines": [
                "で、迷惑な妖怪って？"
            ]
        },
        "130_0": {
            "lines": [
                "お前の事だよ。",
                "また、夜と昼の境界をいじっただろ？"
            ]
        },
        "131_0": {
            "lines": [
                "夜を止めているのは私達。",
                "でも今はそれどころじゃないのよ！"
            ]
        },
        "132_0": {
            "lines": [
                "そう。",
                "あなたは、後ろに目が無いのかしら？"
            ]
        },
        "133_0": {
            "lines": [
                "あー？"
            ]
        },
        "134_0": {
            "lines": [
                "まぁ、多分無いけど。",
                "そういうことよ。"
            ]
        },
        "135_0": {
            "lines": [
                "日本語を話せ。",
                "ここは幻想郷だ。"
            ]
        },
        "136_0": {
            "lines": [
                "魔理沙に何言っても無駄ね。"
            ]
        },
        "137_0": {
            "lines": [
                "あの歪な月は危険なのに……。"
            ]
        },
        "138_0": {
            "lines": [
                "人間には大して害は無いの。"
            ]
        },
        "139_0": {
            "lines": [
                "あー？何だか知らないけど。",
                "夜が終らない方が害だらけだぜ。"
            ]
        },
        "140_0": {
            "lines": [
                "妖怪は夜に人を喰う。"
            ]
        },
        "141_0": {
            "lines": [
                "夜が続けば、喰い過ぎで妖怪は自滅する。"
            ]
        },
        "142_0": {
            "lines": [
                "する訳無いじゃない。"
            ]
        },
        "143_0": {
            "lines": [
                "自滅する前に退治してやらないとな。"
            ]
        }
    },
    "2": {
        "60_0": {
            "lines": [
                "あ、逃げた？"
            ]
        },
        "61_0": {
            "lines": [
                "さぁ、地の果てまで追うのよ。"
            ]
        }
    },
    "3": {
        "60_0": {
            "lines": [
                "あれ、霊夢じゃないか？",
                "どうしたんだ？"
            ]
        },
        "61_0": {
            "lines": [
                "白々しいにも程があるわ。"
            ]
        },
        "62_0": {
            "lines": [
                "さっきのは紫分。",
                "今度はお前分だ！"
            ]
        }
    },
    "1": {
        "60_0": {
            "lines": [
                "魔理沙を追っているうちに、目的地に着いた",
                "みたいね。"
            ]
        },
        "61_0": {
            "lines": [
                "ほんと、あなたって幸運ねぇ。",
                "うちの藍にも分けてあげたいくらいだわ。"
            ]
        },
        "62_0": {
            "lines": [
                "くそ。",
                "一体、何だと言うんだ？"
            ]
        },
        "63_0": {
            "lines": [
                "お陰で犯人がわかったのよ。",
                "あなたは無駄じゃなかったの。"
            ]
        },
        "64_0": {
            "lines": [
                "いや、犯人は判らないけど。",
                "取り合えず、あの屋敷の中にいる。"
            ]
        },
        "65_0": {
            "lines": [
                "まぁ負けたんだから仕様が無い。",
                "帰って寝る。"
            ]
        },
        "66_0": {
            "lines": [
                "起きたら朝になっている事を祈るぜ。"
            ]
        },
        "67_0": {
            "lines": [
                "永遠にお休みなさい。"
            ]
        },
        "68_0": {
            "lines": [
                "まぁ、風邪ひかないようにね。"
            ]
        }
    }
}