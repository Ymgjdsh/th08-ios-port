# Build products and local diagnostics
/build/
/build-*/
/build-ios*/
/ios/build-ios-*.log
*.ipa
*.app
*.dSYM
*.log

# Original copyrighted game data is never committed
*.dat
/resources/th08.exe
/msgothic.ttc

# Local tools, editors, caches, and reverse-engineering state
/.analysis/
/.tools/
/_references/
/local/
/.venv/
/.vscode/
/.idea/
/compile_commands.json
__pycache__/
*.pyc
*.gpr
*.rep/
*.idb
*.i64

# CMake and Ninja files created in an accidental in-tree build
/CMakeCache.txt
/CMakeFiles/
/Makefile
/cmake_install.cmake
/build.ninja
/.ninja_deps
/.ninja_log

# Root-level simulator screenshots and acceptance bundles are local QA data.
# Keep them out of source releases while preserving the files on developer
# machines for regression comparison.
/accept*/
/accept*.png
/pause*.png
/music*.png
/replay*.png
/result*.png
/launch*.png
/jp-*.png
/remote-*.png
/sim-*.png
/zh-*.png
*.crash
